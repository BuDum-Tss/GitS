# Секреты (этот файл-образец можно коммитить; настоящий agent/secrets.env игнорируется git).
# Скопируй в secrets.env и заполни.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
# Как часто она задумывается о посте, минут (по умолчанию 180):
# TELEGRAM_EVERY_MINS=180

# Её собственный аккаунт в Telegram (Telethon). Ключи: my.telegram.org -> API development tools.
# Вход один раз руками: python modules/telegram/tg_login.py (телефон, код и пароль вводишь ты сам).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Движок голоса (модуль voice): auto | espeech | fish | edge. По умолчанию auto: ESpeech, потом Fish Speech, потом edge-tts.
#   espeech: только ESpeech (сервис services/f5-tts запускается вместе с ядром);
#   fish:    Fish Audio / Fish Speech S2-Pro; сам сервис не запускается ядром: docker compose up -d fish-speech
#            (референс голоса resources/<Имя>/voice/GlaDos.wav, веса agent/resources/tts/checkpoints), ESpeech тогда не стартует;
#   edge:    только запасной edge-tts (ESpeech не стартует).
# Менять после правки: перезапустить ядро.
# TTS_ENGINE=auto

# Где лежит репозиторий модуля RimWorld (rimworld-module; ТЗ 11). Если не задано, ядро ищет соседнюю с GitS папку
# rimworld-module, а пока она не переименована, rimworld-agent. Старое имя переменной RIMWORLD_AGENT_DIR ещё читается, но устарело.
# RIMWORLD_MODULE_DIR=C:\MyProjects\rimworld-module

# Где лежит репозиторий модуля монтажа (montage-module; ТЗ 20). Если не задано, ядро ищет соседнюю с GitS папку montage-module,
# затем C:\MyProjects\montage-module. У модуля своё окружение: <папка>\.venv.
# MONTAGE_MODULE_DIR=C:\MyProjects\montage-module
