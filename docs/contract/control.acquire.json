{
  "name": "control.acquire",
  "transport": "http POST /acquire",
  "since": "1.11",
  "errors": [
    {
      "status": 400,
      "description": "тело неверно: `{\"ok\": false, \"error\": \"bad_request\", \"message\": ...}`"
    },
    {
      "status": 401,
      "description": "нет или неверен токен управления: `{\"ok\": false, \"error\": \"unauthorized\"}`"
    },
    {
      "status": 404,
      "description": "у этого участника нет аренды (`ownership` не `shared`)"
    },
    {
      "status": 409,
      "description": "занято другим: `{\"ok\": false, \"state\": \"busy\", \"holder\": {...}}`"
    },
    {
      "status": 502,
      "description": "`on_acquire` не смог подключиться: `{\"ok\": false, \"error\": \"acquire_failed\", \"message\": ...}`, аренда не выдана"
    },
    {
      "status": 503,
      "description": "окружение недоступно: `{\"ok\": false, \"state\": \"offline\"}`"
    }
  ],
  "request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "character": {
        "type": "string",
        "description": "персонаж-хозяин",
        "minLength": 1
      },
      "core_url": {
        "type": "string",
        "description": "адрес ядра хозяина",
        "minLength": 1
      },
      "token": {
        "type": "string",
        "description": "токен подключения к ядру хозяина (в журнал не пишется, в `holder` не отдаётся)",
        "minLength": 1
      },
      "purpose": {
        "type": "string",
        "description": "зачем взято"
      },
      "ttl_s": {
        "type": "number",
        "description": "срок аренды, секунд; больше 3600 обрезается",
        "minimum": 1,
        "maximum": 3600,
        "default": 300
      }
    },
    "additionalProperties": true,
    "required": [
      "character",
      "core_url",
      "token"
    ],
    "title": "POST /acquire",
    "description": "Взять окружение в аренду. При успехе workspace вызывает обработчик `on_acquire(lease)` и подключается к ядру хозяина (`core_url`, `token` из тела). Одна аренда за раз. Повторный запрос того же `character` с тем же `purpose` продлевает аренду (идемпотентно: тот же `lease_id`); если `core_url` или `token` изменились, прежняя аренда закрывается и открывается новая."
  },
  "response": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "true"
      },
      "lease_id": {
        "type": "string",
        "description": "id аренды для renew и release"
      },
      "expires": {
        "type": "number",
        "description": "когда истекает, unix-время в секундах"
      },
      "ttl_s": {
        "type": "number",
        "description": "выданный срок, секунд"
      }
    },
    "additionalProperties": true,
    "required": [
      "ok",
      "lease_id",
      "expires",
      "ttl_s"
    ],
    "title": "POST /acquire (ответ 200)"
  }
}
