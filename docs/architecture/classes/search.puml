@startuml classes_search
set namespaceSeparator none
class "HashEmbedder" as search.embedder.HashEmbedder {
  dim : int
  embed(texts: list[str], query: bool) -> list[list[float]]
}
class "Hit" as search.index.Hit {
  bm25_rank : int | None
  collection : str
  cos : float | None
  id : int
  key : str
  meta : dict
  score : float
  text : str
  ts : float
}
class "HybridIndex" as search.index.HybridIndex {
  collections() -> dict[str, int]
  count(collection: str | None) -> int
  delete(collection: str, key: str) -> bool
  delete_collection(collection: str) -> int
  invalidate(collection: str, key: str) -> bool
  keys(collection: str) -> list[str]
  search(query: str, qvec: list[float] | None) -> list[Hit]
  stats() -> dict[str, dict]
  upsert(collection: str, key: str, text: str) -> int
}
class "HybridSearch" as search.service.HybridSearch {
  cfg
  embedder : Embedder | None
  index
  last_embedded : bool
  llm : LanguageModel | None
  add(collection: str, key: str, text: str) -> int
  delete(collection: str, key: str) -> bool
  search(query: str) -> list[Hit]
}
class "LmStudioEmbedder" as search.embedder.LmStudioEmbedder {
  batch_timeout : float
  query_timeout : float
  embed(texts: list[str], query: bool) -> list[list[float]]
}
class "SearchConfig" as search.index.SearchConfig {
  bm25_top : int
  boosts : dict
  candidates : int
  half_life_days : float
  min_cos : float
  min_cos_bm25 : float
  recency_weight : float
}
search.service.HybridSearch --> search.index.SearchConfig : cfg
search.index.HybridIndex --o search.service.HybridSearch : index
@enduml
