@startuml classes_services.conversation
set namespaceSeparator none
class "Channel" as services.conversation.conversation_io.Channel {
  kind : str
  module : str | None
  target : str | None
  label() -> str
  to_dict() -> dict
}
class "Companion" as services.conversation.companion.Companion {
  attention : NoneType
  context_builder
  conversation
  environment_note
  graph : NoneType
  idle_seconds
  io : NoneType
  job_wait : NoneType
  last_utterance_id : str | None
  memory_capture : MemoryCapture
  memory_reader
  memory_writer
  module_notes
  on_conversation_end : NoneType
  people
  presence
  profile_hint
  reply_generator
  resident
  router : NoneType
  screen_activity
  speech
  workspace_of
  arm_idle_consolidation() -> None
  ask_permission(fact: str) -> None
  cancel_reply(reason: str) -> bool
  is_speaking() -> bool
  note_heard(summary: str) -> None
  on_input(ui: UserInput)
  on_user_message(text: str, channel)
  on_voice(text: str, speaker: dict, trace)
  rebind_memory(memory_dir) -> None
  recent_heard(secs: int) -> str
  remember_text(text: str, hint_kind: str | None) -> list[str]
  say(text: str, sticker: str | None, priority: int | None)
  speak_about(fact: str, user_text: str, must: bool, question: bool, direct: bool)
  wait_speech(max_s: float) -> None
}
class "ContextBuilder" as services.conversation.context_builder.ContextBuilder {
  actions_block(window_s: float, limit: int) -> str
  build(include_hearing: bool, query: str, needs_memory: str | None, role: str, mode: str | None, owner: bool | None) -> str
  capabilities() -> str
  environment_note() -> str
  events_block() -> str
  in_module_env() -> bool
  model_note() -> str
  node_block() -> str
  owner_allowed() -> bool
  refresh_graph(query: str) -> None
  start_retrieval(query: str) -> 'Retrieval'
  use_retrieval(retrieval: 'Retrieval | None', query: str, deadline_s: float | None) -> bool
}
class "ConversationIO" as services.conversation.conversation_io.ConversationIO {
  companion
  hub : NoneType
  deliver(channel: Channel, text: str) -> bool
  from_dashboard(text: str) -> None
  from_module(text: str, reply_channel: dict, sender: dict | None) -> None
  submit(ui: UserInput) -> None
}
class "ConversationService" as services.conversation.service.ConversationService {
  check_correction(text: str) -> None
  handle_text(text: str)
  log_decision(text: str, decision) -> None
  log_route(text: str, route: str) -> None
  on_input(ui: UserInput)
  on_user_message(text: str, channel)
  on_voice(text: str, speaker: dict, trace)
}
class "Piece" as services.conversation.stickers.Piece {
  tag : str | None
  text : str
}
class "PresenceTracker" as services.conversation.speech_out.PresenceTracker {
  DEFAULTS : dict
  listener : Callable[[dict], None] | None
  state : dict
  snapshot() -> dict
  update() -> bool
}
class "ReplyGenerator" as services.conversation.reply_generator.ReplyGenerator {
  declutter(reply: str) -> str
  speak_about(fact: str, user_text: str, must: bool, question: bool, direct: bool)
}
class "ResidentAgent" as services.conversation.resident.ResidentAgent {
  busy : bool
  last_end : float
  cancel() -> None
  handle_event(kind: str, text: str, origin: str, urgent: bool) -> None
  handle_user(text: str, use_memory: bool) -> None
  preempt(kind: str, text: str, origin: str) -> None
  reset(forget: bool) -> None
}
class "Retrieval" as services.conversation.context_builder.Retrieval {
  query
  t0
  task
  cancel() -> None
}
class "SentenceSplitter" as services.conversation.speech_text.SentenceSplitter {
  min_chars : int
  feed(delta: str) -> list[str]
  flush() -> list[str]
}
class "SpeechOutput" as services.conversation.speech_out.SpeechOutput {
  current_segment() -> str
  is_speaking() -> bool
  speak(utterance_id: str, text: str, sticker: str | None, priority: int) -> None
  stop(utterance_id: str | None) -> None
}
class "SpeechSelector" as services.conversation.speech_out.SpeechSelector {
  presence
  text
  voice
  attach(hub, modules) -> None
  current_segment() -> str
  is_speaking() -> bool
  live_count() -> int
  on_event(data: dict) -> None
  speak(utterance_id: str, text: str, sticker: str | None, priority: int) -> None
  stop(utterance_id: str | None) -> None
  supports_streaming() -> bool
  when_audible(utterance_id: str, callback) -> None
}
class "TagStream" as services.conversation.stickers.TagStream {
  feed(delta: str) -> list[Piece]
  flush() -> list[Piece]
}
class "Tagged" as services.conversation.stickers.Tagged {
  sticker : str | None
}
class "TextOnlySpeech" as services.conversation.speech_out.TextOnlySpeech {
  presence
  current_segment() -> str
  is_speaking() -> bool
  speak(utterance_id: str, text: str, sticker: str | None, priority: int) -> None
  stop(utterance_id: str | None) -> None
  supports_streaming() -> bool
}
class "UserInput" as services.conversation.conversation_io.UserInput {
  channel
  sender : dict | None
  text : str
  trace : Optional[object]
  ts : float
}
class "VoiceModuleSpeech" as services.conversation.speech_out.VoiceModuleSpeech {
  START_TIMEOUT_S : float
  hub : NoneType
  modules : NoneType
  presence
  attach(hub, modules) -> None
  available() -> bool
  connection()
  current_segment() -> str
  is_speaking() -> bool
  live_count() -> int
  on_event(data: dict) -> None
  speak(utterance_id: str, text: str, sticker: str | None, priority: int) -> None
  stop(utterance_id: str | None) -> None
  supports_streaming() -> bool
  when_audible(utterance_id: str, callback: Callable[[], None]) -> None
}
services.conversation.conversation_io.UserInput --> services.conversation.conversation_io.Channel : channel
services.conversation.companion.Companion --> services.conversation.speech_out.PresenceTracker : presence
services.conversation.speech_out.TextOnlySpeech --> services.conversation.speech_out.PresenceTracker : presence
services.conversation.speech_out.VoiceModuleSpeech --> services.conversation.speech_out.PresenceTracker : presence
services.conversation.companion.Companion --> services.conversation.speech_out.TextOnlySpeech : speech
services.conversation.context_builder.ContextBuilder --* services.conversation.companion.Companion : context_builder
services.conversation.reply_generator.ReplyGenerator --* services.conversation.companion.Companion : reply_generator
services.conversation.resident.ResidentAgent --* services.conversation.companion.Companion : resident
services.conversation.service.ConversationService --* services.conversation.companion.Companion : conversation
@enduml
