<mxfile host="app.diagrams.net"><diagram name="Архитектура ядра GitS: всё вместе" id="arch2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2062" pageHeight="2091" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g_src" value="Источники событий" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="292" height="718.5" as="geometry"/></mxCell><mxCell id="g_imp" value="Внутренние импульсы" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="780.5" width="292" height="394.5" as="geometry"/></mxCell><mxCell id="g_in" value="Приём" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="372" y="40" width="292" height="701.5" as="geometry"/></mxCell><mxCell id="g_dec" value="Решение" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="714" y="40" width="292" height="672.5" as="geometry"/></mxCell><mxCell id="g_conv" value="Разговор" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1056" y="40" width="292" height="490.0" as="geometry"/></mxCell><mxCell id="g_think" value="Размышление" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1056" y="552.0" width="292" height="394.5" as="geometry"/></mxCell><mxCell id="g_act" value="Дела" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1398" y="40" width="292" height="666.5" as="geometry"/></mxCell><mxCell id="g_foc" value="Фокус" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1398" y="728.5" width="292" height="637.5" as="geometry"/></mxCell><mxCell id="g_out" value="Вывод" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1740" y="40" width="292" height="797.0" as="geometry"/></mxCell><mxCell id="g_mem" value="Память" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="714" y="1398.0" width="884" height="423.5" as="geometry"/></mxCell><mxCell id="g_ext" value="Внешний слой и сборка" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1843.5" width="1938" height="197.5" as="geometry"/></mxCell><mxCell id="voice" value="&lt;b&gt;voice&lt;/b&gt; [Адаптеры]&lt;br&gt;микрофон, VAD, распознавание речи&lt;br&gt;(WhisperX), узнавание голоса; озвучка&lt;br&gt;(Fish Speech)&lt;br&gt;→ Event voice.utterance&lt;br&gt;сейчас: modules/voice" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="44" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="desk" value="&lt;b&gt;desktop&lt;/b&gt; [Адаптеры]&lt;br&gt;экран, активность, мышь и клавиатура,&lt;br&gt;Claude-помощник&lt;br&gt;→ Event desktop.*, job.update&lt;br&gt;сейчас: modules/desktop" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="168.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="tg" value="&lt;b&gt;telegram&lt;/b&gt; [Адаптеры]&lt;br&gt;бот, её аккаунт, посты канала&lt;br&gt;→ Event telegram.*&lt;br&gt;сейчас: modules/telegram" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="278.5" width="268" height="81.5" as="geometry"/></mxCell><mxCell id="rim" value="&lt;b&gt;rimworld&lt;/b&gt; [Адаптеры]&lt;br&gt;игровой агент: ходы, комментатор,&lt;br&gt;запись забега&lt;br&gt;→ Event raid, death, colonists&lt;br&gt;сейчас: modules/rimworld" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="374.0" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="mont" value="&lt;b&gt;montage&lt;/b&gt; [Адаптеры]&lt;br&gt;конвейер роликов: Remotion + ffmpeg,&lt;br&gt;агент Claude&lt;br&gt;→ job.update, вопросы&lt;br&gt;сейчас: modules/montage" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="484.0" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="dash" value="&lt;b&gt;Дашборд и чат&lt;/b&gt; [Адаптеры]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;чат, настройки, пульт, оценки&lt;br&gt;→ UserInput как Event&lt;br&gt;сейчас: dashboard/: роутеры по темам&lt;br&gt;(routes_*.py) и презентеры; настройки&lt;br&gt;через SettingsProvider" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;dashed=1;" vertex="1" parent="g_src"><mxGeometry x="12" y="594.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="reminders" value="&lt;b&gt;ReminderStore&lt;/b&gt; [Адаптеры]&lt;br&gt;напоминания, назначенные самим агентом:&lt;br&gt;срок, текст, откуда пришла мысль&lt;br&gt;→ срок наступил&lt;br&gt;сейчас: есть (ТЗ 30):&lt;br&gt;adapters/impulse_store.py&lt;br&gt;(JsonReminders, файл reminders.json),&lt;br&gt;контракт ReminderRepository; инструмент&lt;br&gt;assistant.remind_self" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_imp"><mxGeometry x="12" y="44.0" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="timer" value="&lt;b&gt;ImpulseTimer&lt;/b&gt; [Адаптеры]&lt;br&gt;следит только за сроками напоминаний;&lt;br&gt;когда срок пришёл, шлёт событие. Не тик&lt;br&gt;болтовни&lt;br&gt;→ Event self.reminder&lt;br&gt;сейчас: есть (ТЗ 30):&lt;br&gt;app/impulse_timer.py, один таймер на&lt;br&gt;ближайший срок, восстановление и&lt;br&gt;склейка просроченного; proactive_loop&lt;br&gt;выключен настройкой proactive_tick" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_imp"><mxGeometry x="12" y="212.0" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;ModuleHub (входящие)&lt;/b&gt; [Адаптеры]&lt;br&gt;WebSocket :8766: рукопожатие, проверка&lt;br&gt;формата, очередь входящих; запросы&lt;br&gt;core.*&lt;br&gt;→ Event&lt;br&gt;сейчас: module_hub.py: приёмник событий&lt;br&gt;EventSink колбэком&lt;br&gt;(adapters/module_events.py), без&lt;br&gt;attention и fast_brain" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_in"><mxGeometry x="12" y="44" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="event" value="&lt;b&gt;Event&lt;/b&gt; [Домен]&lt;br&gt;единый конверт: kind, text, sender,&lt;br&gt;hint, data, trace, ts; источник внешний&lt;br&gt;или внутренний (self)&lt;br&gt;→ сущность&lt;br&gt;сейчас: частично (ТЗ 30):&lt;br&gt;domain/event.py (Event с origin&lt;br&gt;external/self) для импульсов и&lt;br&gt;размышления; внутри внимания остаётся&lt;br&gt;Item (поле origin)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_in"><mxGeometry x="12" y="212.0" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="norm" value="&lt;b&gt;Normalizer&lt;/b&gt; [Сценарии]&lt;br&gt;нормализация, дедупликация за 60 с,&lt;br&gt;склейка повторов, TTL&lt;br&gt;→ Event&lt;br&gt;сейчас: выделен (ТЗ 29, R3):&lt;br&gt;app/normalizer.py, app/items.py&lt;br&gt;(хранилище и склейка), domain/dedupe.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_in"><mxGeometry x="12" y="394.5" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="people" value="&lt;b&gt;PeopleDirectory&lt;/b&gt; [Сценарии]&lt;br&gt;sender → Person, первый контакт,&lt;br&gt;заметки о человеке&lt;br&gt;→ Person&lt;br&gt;сейчас: выделен (R3):&lt;br&gt;Normalizer.note_sender через контракты&lt;br&gt;PeopleDirectory и MemoryWriter;&lt;br&gt;getattr(companion, "_rel") остался&lt;br&gt;только в адаптере adapters/people.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_in"><mxGeometry x="12" y="533.5" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;HardRules&lt;/b&gt; [Домен]&lt;br&gt;до моделей: R1 владелец → разговор, R2&lt;br&gt;ответ на вопрос, R3 mute, R4 критичное,&lt;br&gt;«замолчи»&lt;br&gt;→ RuleResult&lt;br&gt;сейчас: выделен (R3):&lt;br&gt;app/process_event.py HardRules; чистые&lt;br&gt;правила «замолчи» и «похоже на просьбу»&lt;br&gt;в domain/rules.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_dec"><mxGeometry x="12" y="44" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="cls" value="&lt;b&gt;Classifier (контракт)&lt;/b&gt; [Сценарии]&lt;br&gt;категория, срочность, адресат, нужен ли&lt;br&gt;фокус; реализация: служба GLiNER :8768;&lt;br&gt;тайм-аут 1 с&lt;br&gt;→ Classification&lt;br&gt;сейчас: decide.py + services/decider; в&lt;br&gt;Attention его зовёт&lt;br&gt;app/event_classifier.py (R3)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_dec"><mxGeometry x="12" y="212.0" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="score" value="&lt;b&gt;PriorityScorer&lt;/b&gt; [Домен]&lt;br&gt;срочность × 20 × веса (профиль,&lt;br&gt;отправитель, правила, пользователь) ×&lt;br&gt;свежесть&lt;br&gt;→ priority 0..100&lt;br&gt;сейчас: выделен (R3): app/scorer.py&lt;br&gt;поверх domain/scoring.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_dec"><mxGeometry x="12" y="365.5" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="disp" value="&lt;b&gt;Dispatcher&lt;/b&gt; [Сценарии]&lt;br&gt;решение D0–D4 и routes[]: say, chat,&lt;br&gt;task, focus, think, digest, ignore;&lt;br&gt;пишет решение в журнал&lt;br&gt;→ Decision&lt;br&gt;сейчас: выделен (R3): app/dispatcher.py&lt;br&gt;(finish, act) и app/decision_log.py;&lt;br&gt;routes[] пока только say, digest,&lt;br&gt;focus-хук" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_dec"><mxGeometry x="12" y="504.5" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="conv" value="&lt;b&gt;ConversationService&lt;/b&gt; [Сценарии]&lt;br&gt;обращение владельца: проверки → ветка&lt;br&gt;(болтовня / просьба / «что умеешь») →&lt;br&gt;ответ&lt;br&gt;→ Reply или Task&lt;br&gt;сейчас: app/conversation_service.py&lt;br&gt;(фасад Companion)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_conv"><mxGeometry x="12" y="44" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="ctx" value="&lt;b&gt;ContextBuilder&lt;/b&gt; [Сценарии]&lt;br&gt;собирает контекст: характер, память,&lt;br&gt;диалог, состояние; бюджет токенов на&lt;br&gt;роль&lt;br&gt;→ Context&lt;br&gt;сейчас: app/context_builder.py: склейка&lt;br&gt;6 источников; бюджет токенов на роль и&lt;br&gt;блок и режимы push (needs_memory) /&lt;br&gt;pull (recall) в настройке context, по&lt;br&gt;умолчанию прежнее поведение" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_conv"><mxGeometry x="12" y="183.0" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="reply" value="&lt;b&gt;ReplyGenerator&lt;/b&gt; [Сценарии]&lt;br&gt;LanguageModel(fast) → LM Studio&lt;br&gt;(Gemma): ответ; страховки стиля&lt;br&gt;→ ReplyCandidate&lt;br&gt;сейчас: app/reply_generator.py:&lt;br&gt;_converse, _declutter + fast_brain" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_conv"><mxGeometry x="12" y="365.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="reflect" value="&lt;b&gt;ReflectionService&lt;/b&gt; [Сценарии]&lt;br&gt;внутренний диалог в несколько шагов по&lt;br&gt;событию или импульсу; читает память;&lt;br&gt;лимиты шагов и токенов&lt;br&gt;→ Intent: сказать, сделать, напомнить,&lt;br&gt;записать, ничего&lt;br&gt;сейчас: есть (ТЗ 30):&lt;br&gt;app/reflection.py; маршрут think из&lt;br&gt;Dispatcher (domain/rules.think_route);&lt;br&gt;лимиты шагов, токенов, часа, глубины" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_think"><mxGeometry x="12" y="44.0" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="thoughts" value="&lt;b&gt;Журнал мыслей&lt;/b&gt; [Адаптеры]&lt;br&gt;внутренние рассуждения: не&lt;br&gt;озвучиваются; основа дневника и&lt;br&gt;эпизодов&lt;br&gt;→ Thought&lt;br&gt;сейчас: есть (ТЗ 30):&lt;br&gt;adapters/impulse_store.py&lt;br&gt;(JsonThoughts, thoughts.json), GET&lt;br&gt;/api/thoughts" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_think"><mxGeometry x="12" y="226.5" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;ToolRegistry&lt;/b&gt; [Сценарии]&lt;br&gt;инструменты ядра и модулей, видимость&lt;br&gt;по профилю, отбор по смыслу&lt;br&gt;→ Tool[]&lt;br&gt;сейчас: environments/registry.py,&lt;br&gt;tool_search.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_act"><mxGeometry x="12" y="44" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b&gt;Planner&lt;/b&gt; [Сценарии]&lt;br&gt;LanguageModel → LM Studio (Gemma): план&lt;br&gt;шагов или «не могу»&lt;br&gt;→ Plan&lt;br&gt;сейчас: router._plan" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_act"><mxGeometry x="12" y="168.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;RiskPolicy + Approver&lt;/b&gt; [Домен]&lt;br&gt;риск auto / ask / public / danger;&lt;br&gt;вопрос пользователю, ответ да/нет&lt;br&gt;→ Approval&lt;br&gt;сейчас: router._step + approvals.py:&lt;br&gt;301 строка" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_act"><mxGeometry x="12" y="278.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="exec" value="&lt;b&gt;Executor (ToolInvoker)&lt;/b&gt; [Сценарии]&lt;br&gt;вызов инструмента в ядре или модуле,&lt;br&gt;коды ошибок, итог-факт&lt;br&gt;→ ToolResult&lt;br&gt;сейчас: router._step и _run_step" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_act"><mxGeometry x="12" y="403.0" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="jobs" value="&lt;b&gt;JobTracker&lt;/b&gt; [Сценарии]&lt;br&gt;долгие задачи: прогресс, вопросы, итог;&lt;br&gt;Claude-помощник (Agent SDK)&lt;br&gt;→ JobState&lt;br&gt;сейчас: выделен (R3) для внимания:&lt;br&gt;app/jobs.py (JobTracker);&lt;br&gt;module_registry и&lt;br&gt;desktop.assistant_agent как раньше" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_act"><mxGeometry x="12" y="513.0" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="fmgr" value="&lt;b&gt;FocusManager (фасад)&lt;/b&gt; [Сценарии]&lt;br&gt;один слот, протокол переключения,&lt;br&gt;команды пользователя, журнал; прежние&lt;br&gt;публичные методы&lt;br&gt;→ FocusDecision&lt;br&gt;сейчас: focus.py: фасад над четырьмя&lt;br&gt;частями (ТЗ 29, ARC-6)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="44.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="fpol" value="&lt;b&gt;FocusPolicy&lt;/b&gt; [Домен]&lt;br&gt;чистые правила: приоритет, запас,&lt;br&gt;критичное, старение, конфликты&lt;br&gt;→ FocusDecision&lt;br&gt;сейчас: domain/focus_policy.py: gate,&lt;br&gt;ambiguity, дребезг, эшелон" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_foc"><mxGeometry x="12" y="183.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="fque" value="&lt;b&gt;FocusQueue&lt;/b&gt; [Сценарии]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;состояния событий, склейка, старение,&lt;br&gt;сроки&lt;br&gt;→ QueuedEvent&lt;br&gt;сейчас: focus_queue.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;dashed=1;" vertex="1" parent="g_foc"><mxGeometry x="12" y="307.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="fstore" value="&lt;b&gt;CheckpointStore&lt;/b&gt; [Сценарии]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;checkpoint задач и файл focus.json&lt;br&gt;→ checkpoint&lt;br&gt;сейчас: focus_store.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;dashed=1;" vertex="1" parent="g_foc"><mxGeometry x="12" y="417.5" width="268" height="81.5" as="geometry"/></mxCell><mxCell id="fdisp" value="&lt;b&gt;FocusDispatch (контракт)&lt;/b&gt; [Сценарии]&lt;br&gt;Gemma только для неоднозначного; ответ&lt;br&gt;строго проверяется&lt;br&gt;→ Op&lt;br&gt;сейчас: focus_dispatch.py: класс&lt;br&gt;FocusDispatch и validate" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="513.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="queue" value="&lt;b&gt;SpeechQueue&lt;/b&gt; [Сценарии]&lt;br&gt;приоритеты, условия «не перебиваю»,&lt;br&gt;интервалы, прерывание, TTL; чистую&lt;br&gt;политику выбора выделить в домен позже&lt;br&gt;→ Utterance&lt;br&gt;сейчас: speech_queue.py: 296 строк,&lt;br&gt;асинхронный координатор (asyncio-&lt;br&gt;задачи), в домен целиком не переносится" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_out"><mxGeometry x="12" y="44" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="digest" value="&lt;b&gt;Digest&lt;/b&gt; [Сценарии]&lt;br&gt;сводка событий D1 и предложение&lt;br&gt;рассказать&lt;br&gt;→ SpeechCandidate&lt;br&gt;сейчас: выделен (R3): app/digest.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_out"><mxGeometry x="12" y="197.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;SpeechOutput и каналы (контракты)&lt;/b&gt; [Адаптеры]&lt;br&gt;голос (speak), чат, Telegram (deliver),&lt;br&gt;питомец&lt;br&gt;→ доставка&lt;br&gt;сейчас: speech_out.py,&lt;br&gt;conversation_io.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_out"><mxGeometry x="12" y="307.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="aff" value="&lt;b&gt;Presence и эмоции&lt;/b&gt; [Сценарии]&lt;br&gt;говорит ли, эмоция, присутствие;&lt;br&gt;настроение (валентность, возбуждение,&lt;br&gt;быстрые эмоции) затухает к базовому&lt;br&gt;уровню персонажа&lt;br&gt;→ PresenceState&lt;br&gt;сейчас: выделено (ТЗ 26):&lt;br&gt;app/affect_service.py поверх&lt;br&gt;domain/affect.py; PresenceTracker,&lt;br&gt;fast_brain.publish; настроение в&lt;br&gt;ContextBuilder, тон голоса, пороги&lt;br&gt;внимания" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_out"><mxGeometry x="12" y="432.0" width="268" height="197.5" as="geometry"/></mxCell><mxCell id="hubout" value="&lt;b&gt;ModuleHub (исходящие)&lt;/b&gt; [Адаптеры]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;доставка команд модулям: tool.call,&lt;br&gt;speak, policy.activate, job.answer&lt;br&gt;→ ToolResult, события&lt;br&gt;сейчас: module_outbound.py: Outbound&lt;br&gt;(темы, presence с ограничением частоты,&lt;br&gt;job.answer), доступен как&lt;br&gt;ModuleHub.outbound" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;dashed=1;" vertex="1" parent="g_out"><mxGeometry x="12" y="643.5" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="mw" value="&lt;b&gt;MemoryWriter&lt;/b&gt; [Сценарии]&lt;br&gt;сразу: диалог и журнал; в паузе: факты&lt;br&gt;(Gemma + эмбеддинги); раз в 6 реплик:&lt;br&gt;осмысление; во сне: факты эпизодов в&lt;br&gt;граф со ссылкой на эпизод (ТЗ 27)&lt;br&gt;→ MemoryRecord&lt;br&gt;сейчас: app/memory_capture.py: _learn,&lt;br&gt;_consolidate, remember_text +&lt;br&gt;graph_memory.step" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_mem"><mxGeometry x="12" y="44.0" width="268" height="183.0" as="geometry"/></mxCell><mxCell id="mr" value="&lt;b&gt;MemoryReader&lt;/b&gt; [Сценарии]&lt;br&gt;граф + воспоминания о себе + записи;&lt;br&gt;гибридный поиск (search/) подключён:&lt;br&gt;recall() ищет в записях, эпизодах и&lt;br&gt;дневнике (ТЗ 27)&lt;br&gt;→ MemoryHit[]&lt;br&gt;сейчас: graph.search, self_memories,&lt;br&gt;MemoryStore.relevant (два поиска);&lt;br&gt;search/: HybridIndex (FTS5 + векторы +&lt;br&gt;свежесть), HybridSearch, переписывание&lt;br&gt;запроса, Embedder" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_mem"><mxGeometry x="308" y="44.0" width="268" height="183.0" as="geometry"/></mxCell><mxCell id="epi" value="&lt;b&gt;Эпизоды (нарезка + хранилище)&lt;/b&gt; [Сценарии]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;журнал -&gt; эпизоды: границы без LLM&lt;br&gt;(пауза, фокус, задача, собеседник),&lt;br&gt;пики яркости, окно вокруг пика;&lt;br&gt;episodes.db со статусами и версиями&lt;br&gt;→ Episode&lt;br&gt;сейчас: есть (ТЗ 27):&lt;br&gt;domain/episodes.py,&lt;br&gt;app/episode_cutter.py,&lt;br&gt;adapters/episode_store.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;dashed=1;" vertex="1" parent="g_mem"><mxGeometry x="604" y="44.0" width="268" height="183.0" as="geometry"/></mxCell><mxCell id="sleep" value="&lt;b&gt;Режим сна (SleepScheduler + SleepRunner)&lt;/b&gt; [Сценарии]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;фоновая политика памяти: при простое,&lt;br&gt;по расписанию, догоняющий; резюме от&lt;br&gt;первого лица с проверкой, факты в граф,&lt;br&gt;эмбеддинги, сводки, дневник;&lt;br&gt;прерывается между эпизодами&lt;br&gt;→ episode.summary, дневник&lt;br&gt;сейчас: есть (ТЗ 27): app/sleep.py,&lt;br&gt;app/sleep_scheduler.py,&lt;br&gt;app/episode_summary.py, app/diary.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;dashed=1;" vertex="1" parent="g_mem"><mxGeometry x="12" y="241.0" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="erecall" value="&lt;b&gt;EpisodeRecall&lt;/b&gt; [Сценарии]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;поиск эпизодов и дневника по смыслу,&lt;br&gt;recall_episode(id) с разворотом до&lt;br&gt;событий, core.memory.episodes&lt;br&gt;→ MemoryHit[]&lt;br&gt;сейчас: есть (ТЗ 27):&lt;br&gt;app/episode_recall.py,&lt;br&gt;episode_routes.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;dashed=1;" vertex="1" parent="g_mem"><mxGeometry x="308" y="241.0" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="elog" value="&lt;b&gt;EventLog&lt;/b&gt; [Адаптеры]&lt;br&gt;SQLite events.db: журнал событий,&lt;br&gt;трасса, решения&lt;br&gt;→ контракт журнала&lt;br&gt;сейчас: events_log.py: глобальные&lt;br&gt;функции, 16 импортов" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="604" y="241.0" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="stores" value="&lt;b&gt;Диалог, записи, люди&lt;/b&gt; [Адаптеры]&lt;br&gt;JSON: диалог, MemoryStore (планы,&lt;br&gt;напоминания), отношения&lt;br&gt;→ репозитории&lt;br&gt;сейчас: user_memory.py,&lt;br&gt;memory_store.py, relationships.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="900" y="241.0" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="graph" value="&lt;b&gt;FactGraph (контракт)&lt;/b&gt; [Адаптеры]&lt;br&gt;Graphiti: факты с интервалами&lt;br&gt;валидности&lt;br&gt;→ контракт графа&lt;br&gt;сейчас: graph_memory.py: 701 строка" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="1196" y="241.0" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="char" value="&lt;b&gt;CharacterRepo&lt;/b&gt; [Адаптеры]&lt;br&gt;resources/&lt;Имя&gt;: конституция, prompt,&lt;br&gt;канон, голос&lt;br&gt;→ Character&lt;br&gt;сейчас: character.py + resources/" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="1492" y="241.0" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="lms" value="&lt;b&gt;LM Studio :1234&lt;/b&gt; [Внешнее]&lt;br&gt;Gemma (речь, план, факты) и&lt;br&gt;EmbeddingGemma" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="12" y="44.0" width="226" height="139.5" as="geometry"/></mxCell><mxCell id="gli" value="&lt;b&gt;GLiNER decider :8768&lt;/b&gt; [Внешнее]&lt;br&gt;классификатор событий и&lt;br&gt;обращений" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="252" y="44.0" width="226" height="139.5" as="geometry"/></mxCell><mxCell id="falk" value="&lt;b&gt;FalkorDB :6380&lt;/b&gt; [Внешнее]&lt;br&gt;база графа фактов" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="492" y="44.0" width="226" height="139.5" as="geometry"/></mxCell><mxCell id="fish" value="&lt;b&gt;Fish Speech / edge-tts&lt;/b&gt; [Внешнее]&lt;br&gt;синтез речи" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="732" y="44.0" width="226" height="139.5" as="geometry"/></mxCell><mxCell id="wx" value="&lt;b&gt;WhisperX / Whisper&lt;/b&gt; [Внешнее]&lt;br&gt;распознавание речи" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="972" y="44.0" width="226" height="139.5" as="geometry"/></mxCell><mxCell id="cl" value="&lt;b&gt;Claude Agent SDK&lt;/b&gt; [Внешнее]&lt;br&gt;долгие и сложные задачи" style="rounded=1;whiteSpace=wrap;html=1;align=left;