<mxfile host="app.diagrams.net"><diagram name="Архитектура ядра GitS: всё вместе" id="arch2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2062" pageHeight="3088" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g_src" value="Источники событий" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="292" height="1011.0" as="geometry"/></mxCell><mxCell id="g_imp" value="Внутренние импульсы" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1073.0" width="292" height="591.5" as="geometry"/></mxCell><mxCell id="g_in" value="Приём" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="372" y="40" width="292" height="701.5" as="geometry"/></mxCell><mxCell id="g_dec" value="Решение" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="714" y="40" width="292" height="890.0" as="geometry"/></mxCell><mxCell id="g_conv" value="Разговор" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1056" y="40" width="292" height="1437.5" as="geometry"/></mxCell><mxCell id="g_think" value="Размышление" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1056" y="1499.5" width="292" height="612.0" as="geometry"/></mxCell><mxCell id="g_act" value="Дела" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1398" y="40" width="292" height="585.5" as="geometry"/></mxCell><mxCell id="g_foc" value="Среды" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1398" y="647.5" width="292" height="1701.0" as="geometry"/></mxCell><mxCell id="g_out" value="Вывод" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1740" y="40" width="292" height="1145.0" as="geometry"/></mxCell><mxCell id="g_mem" value="Память" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="714" y="2380.5" width="884" height="438.0" as="geometry"/></mxCell><mxCell id="g_ext" value="Внешний слой и сборка" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="2840.5" width="1938" height="197.5" as="geometry"/></mxCell><mxCell id="voice" value="&lt;b&gt;voice&lt;/b&gt; [Адаптеры]&lt;br&gt;микрофон, VAD, распознавание речи&lt;br&gt;(WhisperX), узнавание голоса; озвучка&lt;br&gt;(ESpeech, запасные Fish Speech и edge-&lt;br&gt;tts)&lt;br&gt;→ Event voice.utterance&lt;br&gt;сейчас: modules/voice" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="44" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="desk" value="&lt;b&gt;desktop&lt;/b&gt; [Адаптеры]&lt;br&gt;экран, активность, мышь и клавиатура,&lt;br&gt;Модуль кода&lt;br&gt;→ Event desktop.*, job.update&lt;br&gt;сейчас: modules/desktop" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="183.0" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="tg" value="&lt;b&gt;telegram&lt;/b&gt; [Адаптеры]&lt;br&gt;бот, её аккаунт, посты канала&lt;br&gt;→ Event telegram.*&lt;br&gt;сейчас: modules/telegram" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="293.0" width="268" height="81.5" as="geometry"/></mxCell><mxCell id="tw" value="&lt;b&gt;twitch&lt;/b&gt; [Адаптеры]&lt;br&gt;чат и события канала, ответы в чат,&lt;br&gt;модерация&lt;br&gt;→ Event twitch.*&lt;br&gt;сейчас: modules/twitch" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="388.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="obs" value="&lt;b&gt;obs&lt;/b&gt; [Адаптеры]&lt;br&gt;сцены, трансляция и запись OBS,&lt;br&gt;субтитры в поток (obs-websocket)&lt;br&gt;→ Event obs.*&lt;br&gt;сейчас: modules/obs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="498.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="rim" value="&lt;b&gt;rimworld&lt;/b&gt; [Адаптеры]&lt;br&gt;игровой агент: ходы, комментатор,&lt;br&gt;запись забега&lt;br&gt;→ Event raid, death, colonists&lt;br&gt;сейчас: modules/rimworld" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="608.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="mont" value="&lt;b&gt;montage&lt;/b&gt; [Адаптеры]&lt;br&gt;конвейер роликов: Remotion + ffmpeg,&lt;br&gt;агент Claude&lt;br&gt;→ job.update, вопросы&lt;br&gt;сейчас: modules/montage" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="718.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="dash" value="&lt;b&gt;Дашборд и чат&lt;/b&gt; [Адаптеры]&lt;br&gt;чат, настройки, пульт, оценки&lt;br&gt;→ UserInput как Event&lt;br&gt;сейчас: dashboard/: роутеры по темам&lt;br&gt;(routes_*.py) и презентеры; настройки&lt;br&gt;через SettingsProvider; схема потока&lt;br&gt;данных (flow_trace.py, flow_spec.py,&lt;br&gt;/api/flow; ошибки GLiNER, Claude и&lt;br&gt;выходов отдельно; настройка «Только&lt;br&gt;ядро»)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="828.5" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="reminders" value="&lt;b&gt;ReminderStore&lt;/b&gt; [Адаптеры]&lt;br&gt;напоминания, назначенные самим агентом:&lt;br&gt;срок, текст, откуда пришла мысль; это&lt;br&gt;задачи вида reminder со сроком&lt;br&gt;→ срок наступил&lt;br&gt;сейчас: есть (ТЗ 30, ТЗ 32):&lt;br&gt;adapters/task_reminders.py&lt;br&gt;(TaskReminders поверх общих задач,&lt;br&gt;tasks.db), контракт ReminderRepository;&lt;br&gt;прежний reminders.json переносится один&lt;br&gt;раз (adapters/task_migration.py);&lt;br&gt;инструмент assistant.remind_self" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_imp"><mxGeometry x="12" y="44.0" width="268" height="197.5" as="geometry"/></mxCell><mxCell id="timer" value="&lt;b&gt;ImpulseTimer&lt;/b&gt; [Адаптеры]&lt;br&gt;следит только за сроками напоминаний;&lt;br&gt;когда срок пришёл, шлёт событие. Не тик&lt;br&gt;болтовни&lt;br&gt;→ Event self.reminder&lt;br&gt;сейчас: есть (ТЗ 30):&lt;br&gt;app/impulse_timer.py, один таймер на&lt;br&gt;ближайший срок, восстановление и&lt;br&gt;склейка просроченного; прежний опрос&lt;br&gt;proactive_loop удалён" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_imp"><mxGeometry x="12" y="255.5" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="plans" value="&lt;b&gt;PlanNudger&lt;/b&gt; [Сценарии]&lt;br&gt;планы пользователя со сроком в&lt;br&gt;ближайшие сутки превращает в&lt;br&gt;напоминания себе (без модели)&lt;br&gt;→ напоминание за полчаса до срока&lt;br&gt;сейчас: есть (ТЗ 30):&lt;br&gt;app/plan_nudge.py, просмотр раз в час и&lt;br&gt;при старте; стимул недоверенный" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_imp"><mxGeometry x="12" y="438.0" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;ModuleHub (входящие)&lt;/b&gt; [Адаптеры]&lt;br&gt;WebSocket :8766: рукопожатие, проверка&lt;br&gt;формата, очередь входящих; запросы&lt;br&gt;core.*&lt;br&gt;→ Event&lt;br&gt;сейчас: module_hub.py: приёмник событий&lt;br&gt;EventSink колбэком&lt;br&gt;(adapters/module_events.py), без&lt;br&gt;attention и fast_brain" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_in"><mxGeometry x="12" y="44" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="event" value="&lt;b&gt;Event&lt;/b&gt; [Домен]&lt;br&gt;единый конверт: kind, text, sender,&lt;br&gt;hint, data, trace, ts; источник внешний&lt;br&gt;или внутренний (self)&lt;br&gt;→ сущность&lt;br&gt;сейчас: частично (ТЗ 30):&lt;br&gt;domain/event.py (Event с origin&lt;br&gt;external/self) для импульсов и&lt;br&gt;размышления; внутри внимания остаётся&lt;br&gt;Item (поле origin)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_in"><mxGeometry x="12" y="212.0" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="norm" value="&lt;b&gt;Normalizer&lt;/b&gt; [Сценарии]&lt;br&gt;нормализация, дедупликация за 60 с,&lt;br&gt;склейка повторов, TTL&lt;br&gt;→ Event&lt;br&gt;сейчас: выделен (ТЗ 29, R3):&lt;br&gt;app/normalizer.py, app/items.py&lt;br&gt;(хранилище и склейка), domain/dedupe.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_in"><mxGeometry x="12" y="394.5" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="people" value="&lt;b&gt;PeopleDirectory&lt;/b&gt; [Сценарии]&lt;br&gt;sender → Person, первый контакт,&lt;br&gt;заметки о человеке&lt;br&gt;→ Person&lt;br&gt;сейчас: выделен (R3):&lt;br&gt;Normalizer.note_sender через контракты&lt;br&gt;PeopleDirectory и MemoryWriter;&lt;br&gt;getattr(companion, "_rel") остался&lt;br&gt;только в адаптере adapters/people.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_in"><mxGeometry x="12" y="533.5" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;HardRules&lt;/b&gt; [Домен]&lt;br&gt;до моделей: R1 владелец → разговор, R2&lt;br&gt;ответ на вопрос, R3 mute, R4 критичное,&lt;br&gt;«замолчи»&lt;br&gt;→ RuleResult&lt;br&gt;сейчас: выделен (R3):&lt;br&gt;app/process_event.py HardRules; чистые&lt;br&gt;правила «замолчи» и «похоже на просьбу»&lt;br&gt;в domain/rules.py; жёсткие правила&lt;br&gt;обращений владельца (ТЗ 25): routes.py&lt;br&gt;+ routes/hard_rules.yaml, до любых&lt;br&gt;моделей: «замолчи» (в том числе&lt;br&gt;обрывок), ответ на вопрос о разрешении,&lt;br&gt;экстренные слова" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_dec"><mxGeometry x="12" y="44" width="268" height="226.5" as="geometry"/></mxCell><mxCell id="cls" value="&lt;b&gt;InputClassifier (контракт)&lt;/b&gt; [Сценарии]&lt;br&gt;намерение обращения владельца (chat,&lt;br&gt;action, stop...) до маршрутизатора;&lt;br&gt;события модулей не классифицирует;&lt;br&gt;реализация: служба GLiNER :8768, тайм-&lt;br&gt;аут 2,5 с&lt;br&gt;→ InputClass&lt;br&gt;сейчас: decide.py + services/decider; в&lt;br&gt;Attention его зовёт&lt;br&gt;app/input_classifier.py; без сервиса&lt;br&gt;обращение идёт по правилам" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_dec"><mxGeometry x="12" y="284.5" width="268" height="183.0" as="geometry"/></mxCell><mxCell id="disp" value="&lt;b&gt;Dispatcher&lt;/b&gt; [Сценарии]&lt;br&gt;решение по срочности модуля: 0&lt;br&gt;выбросить (D0); ниже 4 во входящую&lt;br&gt;очередь (D1); 4 сказать (D3); 5 сказать&lt;br&gt;и поставить реакцию (D4). «Не&lt;br&gt;отвлекать» и «пользователь отошёл»&lt;br&gt;уводят в очередь; обращение к ней&lt;br&gt;поднимает до 4&lt;br&gt;→ Decision&lt;br&gt;сейчас: app/dispatcher.py (finish,&lt;br&gt;act), domain/scoring.py (decide: чистая&lt;br&gt;функция), app/decision_log.py;&lt;br&gt;Normalizer.assign_urgency ставит&lt;br&gt;срочность по подсказке модуля; правила&lt;br&gt;boost/only меняют её (RuleStore.stance)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_dec"><mxGeometry x="12" y="481.5" width="268" height="241.0" as="geometry"/></mxCell><mxCell id="routes" value="&lt;b&gt;Routes&lt;/b&gt; [Домен]&lt;br&gt;маршруты события и обращения: reflex (с&lt;br&gt;already_done), chat, task, ignore,&lt;br&gt;think; таблица D0-D4 и R1-R4 →&lt;br&gt;маршруты; жёсткие правила из YAML&lt;br&gt;→ RouteDecision&lt;br&gt;сейчас: есть (ТЗ 25): routes.py,&lt;br&gt;routes/hard_rules.yaml" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_dec"><mxGeometry x="12" y="736.5" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="conv" value="&lt;b&gt;ConversationService&lt;/b&gt; [Сценарии]&lt;br&gt;обращение владельца: жёсткие правила →&lt;br&gt;запись реплики → ответ на вопрос о&lt;br&gt;разрешении или передача единому агенту&lt;br&gt;→ Обращение агенту&lt;br&gt;сейчас: app/conversation_service.py&lt;br&gt;(фасад Companion); жёсткие правила до&lt;br&gt;моделей, запись реплики в потоке (не&lt;br&gt;задерживает ответ), затем&lt;br&gt;ResidentAgent.handle_user" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_conv"><mxGeometry x="12" y="44" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="ctx" value="&lt;b&gt;ContextBuilder&lt;/b&gt; [Сценарии]&lt;br&gt;собирает контекст: характер, память,&lt;br&gt;диалог, состояние; бюджет токенов на&lt;br&gt;роль&lt;br&gt;→ Context&lt;br&gt;сейчас: app/context_builder.py: склейка&lt;br&gt;6 источников; бюджет токенов на роль и&lt;br&gt;блок и режимы push (needs_memory) /&lt;br&gt;pull (recall) в настройке context, по&lt;br&gt;умолчанию прежнее поведение" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_conv"><mxGeometry x="12" y="226.5" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="reply" value="&lt;b&gt;ReplyGenerator&lt;/b&gt; [Сценарии]&lt;br&gt;реплика по факту для очереди речи&lt;br&gt;(объявление, итог, вопрос модуля):&lt;br&gt;LanguageModel(fast) → быстрая модель&lt;br&gt;(Claude без инструментов); страховки&lt;br&gt;стиля declutter&lt;br&gt;→ ReplyCandidate&lt;br&gt;сейчас: app/reply_generator.py:&lt;br&gt;speak_about (факт → реплика),&lt;br&gt;declutter; разговор с владельцем ведёт&lt;br&gt;ResidentAgent" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_conv"><mxGeometry x="12" y="409.0" width="268" height="183.0" as="geometry"/></mxCell><mxCell id="resident" value="&lt;b&gt;ResidentAgent&lt;/b&gt; [Сценарии]&lt;br&gt;единый агент: сообщение владельца,&lt;br&gt;событие, тревога и самоимпульс идут в&lt;br&gt;одну постоянную сессию через контракт&lt;br&gt;AgentRuntime (Claude SDK или pi,&lt;br&gt;настройка agent_runtime); инструменты&lt;br&gt;find_tools и call_tool описаны один раз&lt;br&gt;(ToolSpec) поверх реестра и&lt;br&gt;маршрутизатора (разрешения те же);&lt;br&gt;текст агента звучит по мере появления;&lt;br&gt;на среде, которая умеет steer (pi),&lt;br&gt;новое сообщение владельца и событие&lt;br&gt;подмешиваются в идущий ход&lt;br&gt;→ Reply и ToolResult&lt;br&gt;сейчас: app/resident.py: больше не&lt;br&gt;знает про SDK; сброс после сбоя;&lt;br&gt;тревога обрывает ход (preempt), на pi&lt;br&gt;без сброса истории" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_conv"><mxGeometry x="12" y="606.0" width="268" height="284.5" as="geometry"/></mxCell><mxCell id="rtc" value="&lt;b&gt;AgentRuntime (контракт)&lt;/b&gt; [Адаптеры]&lt;br&gt;среда исполнения единого агента:&lt;br&gt;start(system, tools), run(prompt) -&gt;&lt;br&gt;события text / tool / end, steer,&lt;br&gt;abort, reset, close; can_steer&lt;br&gt;→ RuntimeEvent&lt;br&gt;сейчас: contracts.py: AgentRuntime,&lt;br&gt;ToolSpec, TextEvent, ToolEvent,&lt;br&gt;EndEvent" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_conv"><mxGeometry x="12" y="904.5" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="rtcl" value="&lt;b&gt;ClaudeRuntime&lt;/b&gt; [Адаптеры]&lt;br&gt;Claude Agent SDK: ClaudeSDKClient,&lt;br&gt;инструменты ядра как SDK MCP-сервер&lt;br&gt;core, продолжение сессии после&lt;br&gt;перезапуска, сброс после 60 обращений,&lt;br&gt;interrupt, учёт лимита и расхода; steer&lt;br&gt;нет&lt;br&gt;→ RuntimeEvent&lt;br&gt;сейчас: adapters/runtime_claude.py (по&lt;br&gt;умолчанию)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_conv"><mxGeometry x="12" y="1072.5" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="rtpi" value="&lt;b&gt;PiRuntime&lt;/b&gt; [Адаптеры]&lt;br&gt;pi по подписке ChatGPT: запускает мост&lt;br&gt;Node, говорит с ним строками JSON,&lt;br&gt;исполняет tool_call обработчиками&lt;br&gt;ToolSpec, steer и abort посреди хода,&lt;br&gt;история в resident_pi_session.json;&lt;br&gt;процесс умер: ход кончается ошибкой,&lt;br&gt;следующий поднимает мост заново&lt;br&gt;→ RuntimeEvent&lt;br&gt;сейчас: adapters/runtime_pi.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_conv"><mxGeometry x="12" y="1255.0" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="reflect" value="&lt;b&gt;ReflectionService&lt;/b&gt; [Сценарии]&lt;br&gt;внутренний диалог в несколько шагов;&lt;br&gt;запускают напоминание себе, итог&lt;br&gt;разговора и эпизода и пачка из входящей&lt;br&gt;очереди (inbox.batch); читает память;&lt;br&gt;лимиты шагов и токенов; сам переносит&lt;br&gt;созревшие мысли в память (consolidate)&lt;br&gt;→ Intent: сказать, сделать, напомнить,&lt;br&gt;записать, ничего&lt;br&gt;сейчас: есть (ТЗ 30):&lt;br&gt;app/reflection.py; маршрут think из&lt;br&gt;Dispatcher (domain/rules.think_route)&lt;br&gt;для self-событий и итогов эпизодов,&lt;br&gt;пачку шлёт Inbox.tick; отдельного&lt;br&gt;размышления в простое и&lt;br&gt;ThoughtConsolidator больше нет (перенос&lt;br&gt;мыслей внутри сервиса); лимиты шагов,&lt;br&gt;токенов, часа, глубины; после разговора&lt;br&gt;(self.after_conversation) и эпизода&lt;br&gt;подводит итог: настроение и вывод&lt;br&gt;(IMP-10)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_think"><mxGeometry x="12" y="44.0" width="268" height="328.0" as="geometry"/></mxCell><mxCell id="thoughts" value="&lt;b&gt;Журнал мыслей&lt;/b&gt; [Адаптеры]&lt;br&gt;краткосрочная память: значимые&lt;br&gt;рассуждения с оценкой важности 1-5&lt;br&gt;(пустые и оборванные не пишутся),&lt;br&gt;важные переносятся в долговременную&lt;br&gt;память, мелкие забываются через сутки;&lt;br&gt;не озвучиваются&lt;br&gt;→ Thought&lt;br&gt;сейчас: есть (ТЗ 30):&lt;br&gt;adapters/impulse_store.py&lt;br&gt;(JsonThoughts, thoughts.json),&lt;br&gt;domain/thoughts.py, GET /api/thoughts,&lt;br&gt;вкладка «Мысли» дашборда" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_think"><mxGeometry x="12" y="386.0" width="268" height="212.0" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;ToolRegistry&lt;/b&gt; [Сценарии]&lt;br&gt;инструменты ядра и модулей, видимость&lt;br&gt;по профилю, отбор по смыслу&lt;br&gt;→ Tool[]&lt;br&gt;сейчас: environments/registry.py,&lt;br&gt;tool_search.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_act"><mxGeometry x="12" y="44" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;RiskPolicy + Approver&lt;/b&gt; [Домен]&lt;br&gt;риск auto / ask / public / danger;&lt;br&gt;вопрос пользователю, ответ да/нет&lt;br&gt;→ Approval&lt;br&gt;сейчас: router._step_inner +&lt;br&gt;approvals.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_act"><mxGeometry x="12" y="168.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="exec" value="&lt;b&gt;Executor (ToolInvoker)&lt;/b&gt; [Сценарии]&lt;br&gt;вызов инструмента в ядре или модуле,&lt;br&gt;коды ошибок, итог-факт&lt;br&gt;→ ToolResult&lt;br&gt;сейчас: router.run_tool_ex и _step:&lt;br&gt;проверка параметров, риск, вопрос о&lt;br&gt;разрешении, вызов" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_act"><mxGeometry x="12" y="293.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="jobs" value="&lt;b&gt;JobTracker&lt;/b&gt; [Сценарии]&lt;br&gt;долгие задачи: прогресс, вопросы, итог;&lt;br&gt;Модуль кода (Agent SDK)&lt;br&gt;→ JobState&lt;br&gt;сейчас: выделен (R3) для внимания:&lt;br&gt;app/jobs.py (JobTracker);&lt;br&gt;module_registry и&lt;br&gt;desktop.assistant_agent как раньше" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_act"><mxGeometry x="12" y="432.0" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="fmgr" value="&lt;b&gt;ModuleLink&lt;/b&gt; [Сценарии]&lt;br&gt;вход, выход и возобновление среды&lt;br&gt;модуля по протоколу workspace.enter /&lt;br&gt;exit / resume (прежние policy.activate&lt;br&gt;/ focus.release / focus.resume как&lt;br&gt;откат); один слот, checkpoint в памяти;&lt;br&gt;очереди событий, закрепления и второго&lt;br&gt;эшелона решений нет&lt;br&gt;→ Workspace&lt;br&gt;сейчас: app/module_link.py (вместо&lt;br&gt;менеджера фокуса ТЗ 18)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="44.0" width="268" height="183.0" as="geometry"/></mxCell><mxCell id="wsm" value="&lt;b&gt;WorkspaceManager&lt;/b&gt; [Сценарии]&lt;br&gt;в какой среде агент сейчас: assistant,&lt;br&gt;sleep и среды модулей из их манифестов&lt;br&gt;(rimworld, montage); причина, цель,&lt;br&gt;история. В среду модуля входят только&lt;br&gt;по импульсу (сообщение, самоимпульс);&lt;br&gt;события чужих сред среду не&lt;br&gt;переключают, они идут в очередь речи и&lt;br&gt;сводку&lt;br&gt;→ Workspace&lt;br&gt;сейчас: app/workspace_manager.py (ТЗ&lt;br&gt;32): поверх ModuleLink, сон приходит от&lt;br&gt;планировщика сна; инструменты&lt;br&gt;workspace.switch и workspace.status,&lt;br&gt;признак самоимпульса&lt;br&gt;app/impulse_origin.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="241.0" width="268" height="255.5" as="geometry"/></mxCell><mxCell id="wsdom" value="&lt;b&gt;WorkspaceRules&lt;/b&gt; [Домен]&lt;br&gt;чистые правила: кто и по какой причине&lt;br&gt;может войти в среду и выйти из неё&lt;br&gt;→ Workspace&lt;br&gt;сейчас: domain/workspace.py (ТЗ 32)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_foc"><mxGeometry x="12" y="510.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="tsvc" value="&lt;b&gt;TaskService&lt;/b&gt; [Сценарии]&lt;br&gt;общие задачи всех сред: создание,&lt;br&gt;подзадачи, активная задача среды,&lt;br&gt;checkpoint при уходе и возобновление,&lt;br&gt;закрытие; события task.* в журнал&lt;br&gt;→ Task&lt;br&gt;сейчас: app/task_service.py (ТЗ 32,&lt;br&gt;WS-8); сборка task_wiring.py;&lt;br&gt;инструменты assistant.tasks,&lt;br&gt;create_task, close_task" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="620.5" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="tdom" value="&lt;b&gt;TaskRules&lt;/b&gt; [Домен]&lt;br&gt;чистые правила задач: статусы,&lt;br&gt;следующий шаг, статус родителя по&lt;br&gt;подзадачам, можно ли прервать, какие&lt;br&gt;пора напомнить&lt;br&gt;→ Task&lt;br&gt;сейчас: domain/tasks.py (ТЗ 32)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_foc"><mxGeometry x="12" y="803.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="tplan" value="&lt;b&gt;Planner (задачи)&lt;/b&gt; [Сценарии]&lt;br&gt;цель → шаги через LanguageModel;&lt;br&gt;одинаков для всех сред, сама среда не&lt;br&gt;планирует&lt;br&gt;→ Step[]&lt;br&gt;сейчас: app/planner.py (LlmPlanner),&lt;br&gt;контракт Planner; промпт planner в&lt;br&gt;prompt.yaml" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="942.0" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="npanel" value="&lt;b&gt;NodePanel&lt;/b&gt; [Сценарии]&lt;br&gt;панель узла рабочего места: пока агент&lt;br&gt;в среде модуля с деревом узлов, ядро&lt;br&gt;вызывает запросы nodes[].context и&lt;br&gt;кладёт ответ в контекст агента блоком&lt;br&gt;«Рабочее место» (без модели: факты даёт&lt;br&gt;модуль, ядро укладывает в бюджет и&lt;br&gt;показывает изменения); узел берётся из&lt;br&gt;state.node, видимость инструментов по&lt;br&gt;tools[].node, срочность по&lt;br&gt;nodes[].watch&lt;br&gt;→ Context block&lt;br&gt;сейчас: app/node_panel.py (ТЗ 33),&lt;br&gt;core_service.wire_workspace_nodes;&lt;br&gt;правила: docs/WORKSPACE_MODULES.md" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="1095.5" width="268" height="241.0" as="geometry"/></mxCell><mxCell id="wloop" value="&lt;b&gt;WorkLoop&lt;/b&gt; [Сценарии]&lt;br&gt;автономная работа единого агента в&lt;br&gt;среде контентного модуля&lt;br&gt;(workspace.autonomous): пока агент&lt;br&gt;свободен, раз в work_interval_s шлёт&lt;br&gt;ему самоимпульс self.work_tick (маршрут&lt;br&gt;think); молчит при «не отвлекать»,&lt;br&gt;выключенной настройке autoplay, занятом&lt;br&gt;агенте и лимите Claude&lt;br&gt;→ self.work_tick&lt;br&gt;сейчас: app/work_loop.py (ТЗ 33),&lt;br&gt;core_service" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="1350.5" width="268" height="197.5" as="geometry"/></mxCell><mxCell id="tstore" value="&lt;b&gt;TaskStore&lt;/b&gt; [Адаптеры]&lt;br&gt;SQLite tasks.db в папке памяти&lt;br&gt;персонажа: дерево задач, напоминания и&lt;br&gt;планы как задачи&lt;br&gt;→ Task&lt;br&gt;сейчас: adapters/task_store.py (ТЗ 32),&lt;br&gt;контракт TaskRepository" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_foc"><mxGeometry x="12" y="1562.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="queue" value="&lt;b&gt;SpeechQueue&lt;/b&gt; [Сценарии]&lt;br&gt;приоритеты, условия «не перебиваю»,&lt;br&gt;интервалы, прерывание, TTL; чистую&lt;br&gt;политику выбора выделить в домен позже&lt;br&gt;→ Utterance&lt;br&gt;сейчас: speech_queue.py: 296 строк,&lt;br&gt;асинхронный координатор (asyncio-&lt;br&gt;задачи), в домен целиком не переносится" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_out"><mxGeometry x="12" y="44" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="digest" value="&lt;b&gt;Inbox + Digest&lt;/b&gt; [Сценарии]&lt;br&gt;одна входящая очередь на все модули:&lt;br&gt;события срочности ниже 4 копятся с&lt;br&gt;весом срочность × новизна (редкий вид&lt;br&gt;весит больше) × среда (модуль текущей&lt;br&gt;среды ×2, чужие ×0,5; полная очередь&lt;br&gt;теряет самое лёгкое, а не самое&lt;br&gt;старое); когда есть что-то заметное&lt;br&gt;(2+) или много мелочи (в пачку идут 10&lt;br&gt;самых весомых), модель не занята, нет&lt;br&gt;разговора, «не отвлекать» выключено и&lt;br&gt;прошла минута, накопившееся уходит&lt;br&gt;размышлению одним событием inbox.batch&lt;br&gt;→ inbox.batch&lt;br&gt;сейчас: app/inbox.py (Inbox.tick из&lt;br&gt;цикла внимания, Inbox.blocker: почему&lt;br&gt;пачка ждёт), app/digest.py (история&lt;br&gt;исходов события: ждёт, в контексте,&lt;br&gt;сказано, выброшено, вытеснено; peek&lt;br&gt;даёт самые весомые ждущие события в&lt;br&gt;контекст ответа); вкладка «Состояние»&lt;br&gt;показывает это через GET /api/buffer;&lt;br&gt;настройка&lt;br&gt;attention.inbox.min_interval_s; промпт&lt;br&gt;inbox в prompt.yaml; пачка&lt;br&gt;недоверенная: только сказать или&lt;br&gt;запомнить" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_out"><mxGeometry x="12" y="197.5" width="268" height="415.0" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;SpeechOutput и каналы (контракты)&lt;/b&gt; [Адаптеры]&lt;br&gt;голос (speak), чат, Telegram (deliver),&lt;br&gt;питомец&lt;br&gt;→ доставка&lt;br&gt;сейчас: speech_out.py,&lt;br&gt;conversation_io.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_out"><mxGeometry x="12" y="626.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="aff" value="&lt;b&gt;Presence и стикеры&lt;/b&gt; [Сценарии]&lt;br&gt;говорит ли, стикер, присутствие; эмоций&lt;br&gt;нет: стикер питомца выбирает тег в&lt;br&gt;тексте ответа (`[question]` перед&lt;br&gt;предложением), текст режется по тегам&lt;br&gt;на куски, каждый звучит со своим&lt;br&gt;стикером&lt;br&gt;→ PresenceState&lt;br&gt;сейчас: domain/stickers.py (теги,&lt;br&gt;разбор потока), app/reply_generator.py&lt;br&gt;(куски ответа),&lt;br&gt;speech_out.PresenceTracker (sticker,&lt;br&gt;sticker_ts); GLiNER эмоции не&lt;br&gt;распознаёт, только решения" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_out"><mxGeometry x="12" y="751.0" width="268" height="226.5" as="geometry"/></mxCell><mxCell id="hubout" value="&lt;b&gt;ModuleHub (исходящие)&lt;/b&gt; [Адаптеры]&lt;br&gt;доставка команд модулям: tool.call,&lt;br&gt;speak, policy.activate, job.answer&lt;br&gt;→ ToolResult, события&lt;br&gt;сейчас: module_outbound.py: Outbound&lt;br&gt;(темы, presence с ограничением частоты,&lt;br&gt;job.answer), доступен как&lt;br&gt;ModuleHub.outbound" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_out"><mxGeometry x="12" y="991.5" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="mw" value="&lt;b&gt;MemoryWriter&lt;/b&gt; [Сценарии]&lt;br&gt;сразу: диалог и журнал; важное (оценка&lt;br&gt;4-5) в профиль владельца, планы в&lt;br&gt;задачи; в паузе: факты с оценкой&lt;br&gt;важности (Gemma + эмбеддинги); раз в 6&lt;br&gt;реплик: осмысление; во сне: факты&lt;br&gt;эпизодов в граф со ссылкой на эпизод&lt;br&gt;(ТЗ 27)&lt;br&gt;→ MemoryRecord&lt;br&gt;сейчас: app/memory_capture.py: _learn,&lt;br&gt;_consolidate, remember_text +&lt;br&gt;graph_memory.step" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_mem"><mxGeometry x="12" y="44.0" width="268" height="197.5" as="geometry"/></mxCell><mxCell id="mr" value="&lt;b&gt;MemoryReader&lt;/b&gt; [Сценарии]&lt;br&gt;профиль владельца (если говорит он) +&lt;br&gt;факты графа по теме; гибридный поиск&lt;br&gt;(search/) подключён: recall() ищет в&lt;br&gt;фактах, эпизодах и дневнике (ТЗ 27)&lt;br&gt;→ MemoryHit[]&lt;br&gt;сейчас: graph.profile_block (профиль&lt;br&gt;владельца, если говорит он),&lt;br&gt;graph.search, self_memories; search/:&lt;br&gt;HybridIndex (FTS5 + векторы +&lt;br&gt;свежесть), HybridSearch, переписывание&lt;br&gt;запроса, Embedder" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_mem"><mxGeometry x="308" y="44.0" width="268" height="197.5" as="geometry"/></mxCell><mxCell id="epi" value="&lt;b&gt;Эпизоды (нарезка + хранилище)&lt;/b&gt; [Сценарии]&lt;br&gt;журнал -&gt; эпизоды: границы без LLM&lt;br&gt;(пауза, фокус, задача, собеседник),&lt;br&gt;пики яркости, окно вокруг пика;&lt;br&gt;episodes.db со статусами и версиями&lt;br&gt;→ Episode&lt;br&gt;сейчас: есть (ТЗ 27):&lt;br&gt;domain/episodes.py,&lt;br&gt;app/episode_cutter.py,&lt;br&gt;adapters/episode_store.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_mem"><mxGeometry x="604" y="44.0" width="268" height="197.5" as="geometry"/></mxCell><mxCell id="sleep" value="&lt;b&gt;Режим сна (SleepScheduler + SleepRunner)&lt;/b&gt; [Сценарии]&lt;br&gt;фоновая политика памяти: при простое,&lt;br&gt;по расписанию, догоняющий; резюме от&lt;br&gt;первого лица с проверкой, факты в граф,&lt;br&gt;эмбеддинги, сводки, дневник;&lt;br&gt;прерывается между эпизодами&lt;br&gt;→ episode.summary, дневник&lt;br&gt;сейчас: есть (ТЗ 27): app/sleep.py,&lt;br&gt;app/sleep_scheduler.py,&lt;br&gt;app/episode_summary.py, app/diary.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_mem"><mxGeometry x="12" y="255.5" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="erecall" value="&lt;b&gt;EpisodeRecall&lt;/b&gt; [Сценарии]&lt;br&gt;поиск эпизодов и дневника по смыслу,&lt;br&gt;recall_episode(id) с разворотом до&lt;br&gt;событий, core.memory.episodes&lt;br&gt;→ MemoryHit[]&lt;br&gt;сейчас: есть (ТЗ 27):&lt;br&gt;app/episode_recall.py,&lt;br&gt;episode_routes.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_mem"><mxGeometry x="308" y="255.5" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="elog" value="&lt;b&gt;EventLog&lt;/b&gt; [Адаптеры]&lt;br&gt;SQLite events.db: журнал событий,&lt;br&gt;трасса, решения&lt;br&gt;→ контракт журнала&lt;br&gt;сейчас: events_log.py: глобальные&lt;br&gt;функции, 16 импортов" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="604" y="255.5" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="stores" value="&lt;b&gt;Диалог, задачи, люди&lt;/b&gt; [Адаптеры]&lt;br&gt;JSON: диалог и активность; планы и&lt;br&gt;напоминания это задачи (tasks.db);&lt;br&gt;отношения&lt;br&gt;→ репозитории&lt;br&gt;сейчас: user_memory.py,&lt;br&gt;adapters/task_store.py,&lt;br&gt;relationships.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="900" y="255.5" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="graph" value="&lt;b&gt;FactGraph (контракт)&lt;/b&gt; [Адаптеры]&lt;br&gt;SQLite graph.db (fact_store.py, поиск&lt;br&gt;через HybridIndex): факты с интервалами&lt;br&gt;валидности; области global и&lt;br&gt;&lt;id&gt;:&lt;область&gt; по профилю&lt;br&gt;(graph_scope.py, ТЗ 04 KB-12/13), в&lt;br&gt;контексте до 3 фактов&lt;br&gt;→ контракт графа&lt;br&gt;сейчас: graph_memory.py: 701 строка" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="1196" y="255.5" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="char" value="&lt;b&gt;CharacterRepo&lt;/b&gt; [Адаптеры]&lt;br&gt;resources/&lt;Имя&gt;: конституция, prompt,&lt;br&gt;канон, голос&lt;br&gt;→ Character&lt;br&gt;сейчас: character.py + resources/" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="1492" y="255.5" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="lms" value="&lt;b&gt;LM Studio :1234&lt;/b&gt; [Внешнее]&lt;br&gt;EmbeddingGemma (поиск) и разбор&lt;br&gt;фактов графа (Gemma); ответов и&lt;br&gt;планов в нём больше нет" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="12" y="44.0" width="226" height="139.5" as="geometry"/></mxCell><mxCell id="gli" value="&lt;b&gt;GLiNER decider :8768&lt;/b&gt; [Внешнее]&lt;br&gt;классификатор событий и&lt;br&gt;обращений" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="252" y="44.0" width="226" height="139.5" as="geometry"/></mxCell><mxCell id="fish" value="&lt;b&gt;ESpeech :8771 / Fish Speech / edge-tts&lt;/b&gt; [Внешнее]&lt;br&gt;синтез речи (F5-TTS, русский)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="492" y="44.0" width="226" height="139.5" as="geometry"/></mxCell><mxCell id="wx" value="&lt;b&gt;WhisperX / Whisper&lt;/b&gt; [Внешнее]&lt;br&gt;распознавание речи" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="732" y="44.0" width="226" height="139.5" as="geometry"/></mxCell><mxCell id="cl" value="&lt;b&gt;Claude Agent SDK&lt;/b&gt; [Внешнее]&lt;br&gt;единый агент, быстрая модель без&lt;br&gt;инструментов (claude_llm.py) и&lt;br&gt;долгие задачи" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="972" y="44.0" width="226" height="139.5" as="geometry"/></mxCell><mxCell id="bridge" value="&lt;b&gt;services/agent-runtime (Node)&lt;/b&gt; [Внешнее]&lt;br&gt;мост к pi-agent-core: процесс&lt;br&gt;Node, протокол строк JSON по&lt;br&gt;stdin и stdout; модель по&lt;br&gt;подписке ChatGPT (вход auth.json&lt;br&gt;вручную)&lt;br&gt;сейчас: services/agent-&lt;br&gt;runtime/bridge.mjs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="1212" y="44.0" width="226" height="139.5" as="geometry"/></mxCell><mxCell id="sup" value="&lt;b&gt;Supervisor&lt;/b&gt; [Адаптеры]&lt;br&gt;запуск и перезапуск процессов&lt;br&gt;модулей&lt;br&gt;сейчас: supervisor.py: 573&lt;br&gt;строки; режим «только ядро»&lt;br&gt;(GITS_NO_MODULES=1 или настройка&lt;br&gt;only_core); устойчивость ядра&lt;br&gt;проверяет tools/soak_core.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_ext"><mxGeometr