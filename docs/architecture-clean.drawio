<mxfile host="app.diagrams.net"><diagram name="Архитектура ядра GitS: всё вместе" id="arch2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2062" pageHeight="3459" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g_src" value="Источники событий" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="292" height="959.0" as="geometry"/></mxCell><mxCell id="g_imp" value="Внутренние импульсы" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1021.0" width="292" height="606.0" as="geometry"/></mxCell><mxCell id="g_in" value="Приём" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="372" y="40" width="292" height="971.0" as="geometry"/></mxCell><mxCell id="g_dec" value="Решение" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="714" y="40" width="292" height="1203.0" as="geometry"/></mxCell><mxCell id="g_conv" value="Разговор" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1056" y="40" width="292" height="1284.0" as="geometry"/></mxCell><mxCell id="g_think" value="Размышление" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1056" y="1346.0" width="292" height="626.5" as="geometry"/></mxCell><mxCell id="g_act" value="Дела" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1398" y="40" width="292" height="585.5" as="geometry"/></mxCell><mxCell id="g_foc" value="Среды" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1398" y="647.5" width="292" height="1999.5" as="geometry"/></mxCell><mxCell id="g_out" value="Вывод" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1740" y="40" width="292" height="1246.5" as="geometry"/></mxCell><mxCell id="g_mem" value="Память" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="714" y="2679.0" width="884" height="496.0" as="geometry"/></mxCell><mxCell id="g_ext" value="Внешний слой и сборка" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="3197.0" width="1938" height="212.0" as="geometry"/></mxCell><mxCell id="voice" value="&lt;b&gt;voice&lt;/b&gt; [Адаптеры]&lt;br&gt;микрофон, VAD, локальное распознавание&lt;br&gt;речи (GigaAM, запасной faster-whisper;&lt;br&gt;говорящих не различает, реплика от&lt;br&gt;владельца); озвучка (ESpeech, запасные&lt;br&gt;Fish Speech и edge-tts)&lt;br&gt;→ Event voice.utterance&lt;br&gt;сейчас: services/voice" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="44" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="desk" value="&lt;b&gt;desktop&lt;/b&gt; [Адаптеры]&lt;br&gt;экран, активность, мышь и клавиатура,&lt;br&gt;Модуль кода&lt;br&gt;→ Event desktop.*, job.update&lt;br&gt;сейчас: workspaces/desktop" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="197.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="tg" value="&lt;b&gt;telegram&lt;/b&gt; [Адаптеры]&lt;br&gt;бот, её аккаунт, посты канала&lt;br&gt;→ Event telegram.*&lt;br&gt;сейчас: workspaces/telegram" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="307.5" width="268" height="81.5" as="geometry"/></mxCell><mxCell id="strm" value="&lt;b&gt;streamer&lt;/b&gt; [Адаптеры]&lt;br&gt;ведение трансляции: чат и события&lt;br&gt;Twitch, ответы, модерация; сцены,&lt;br&gt;запись и субтитры OBS (obs-websocket)&lt;br&gt;→ Event twitch.*, obs.*&lt;br&gt;сейчас: workspaces/streamer: подсистемы&lt;br&gt;twitch/ и obs/" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="403.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="rim" value="&lt;b&gt;rimworld&lt;/b&gt; [Адаптеры]&lt;br&gt;игровой агент: ходы, комментатор,&lt;br&gt;запись забега&lt;br&gt;→ Event raid, death, colonists&lt;br&gt;сейчас: workspaces/rimworld" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="542.0" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="mont" value="&lt;b&gt;montage&lt;/b&gt; [Адаптеры]&lt;br&gt;конвейер роликов: Remotion + ffmpeg,&lt;br&gt;агент Claude&lt;br&gt;→ job.update, вопросы&lt;br&gt;сейчас: workspaces/montage" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="652.0" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="dash" value="&lt;b&gt;Дашборд и чат&lt;/b&gt; [Адаптеры]&lt;br&gt;чат, настройки, пульт, оценки&lt;br&gt;→ UserInput как Event&lt;br&gt;сейчас: dashboard/: роутеры по темам&lt;br&gt;(routes_*.py) и презентеры; настройки&lt;br&gt;через SettingsProvider; схема потока&lt;br&gt;данных (services/tracing/flow_trace.py,&lt;br&gt;services/tracing/flow_spec.py,&lt;br&gt;/api/flow; ошибки GLiNER, Claude и&lt;br&gt;выходов отдельно; настройка «Только&lt;br&gt;ядро»)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="762.0" width="268" height="183.0" as="geometry"/></mxCell><mxCell id="reminders" value="&lt;b&gt;ReminderStore&lt;/b&gt; [Адаптеры]&lt;br&gt;напоминания, назначенные самим агентом:&lt;br&gt;срок, текст, откуда пришла мысль; это&lt;br&gt;задачи вида reminder со сроком&lt;br&gt;→ срок наступил&lt;br&gt;сейчас: есть (ТЗ 30, ТЗ 32):&lt;br&gt;services/tasks/reminders.py&lt;br&gt;(TaskReminders поверх общих задач,&lt;br&gt;tasks.db), контракт ReminderRepository;&lt;br&gt;прежний reminders.json переносится один&lt;br&gt;раз (services/tasks/migration.py);&lt;br&gt;инструмент assistant.remind_self" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_imp"><mxGeometry x="12" y="44.0" width="268" height="197.5" as="geometry"/></mxCell><mxCell id="timer" value="&lt;b&gt;ImpulseTimer&lt;/b&gt; [Адаптеры]&lt;br&gt;следит только за сроками напоминаний;&lt;br&gt;когда срок пришёл, шлёт событие. Не тик&lt;br&gt;болтовни&lt;br&gt;→ Event self.reminder&lt;br&gt;сейчас: есть (ТЗ 30):&lt;br&gt;services/reflection/timer.py, один&lt;br&gt;таймер на ближайший срок,&lt;br&gt;восстановление и склейка просроченного;&lt;br&gt;прежний опрос proactive_loop удалён" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_imp"><mxGeometry x="12" y="255.5" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="plans" value="&lt;b&gt;PlanNudger&lt;/b&gt; [Сценарии]&lt;br&gt;планы пользователя со сроком в&lt;br&gt;ближайшие сутки превращает в&lt;br&gt;напоминания себе (без модели)&lt;br&gt;→ напоминание за полчаса до срока&lt;br&gt;сейчас: есть (ТЗ 30):&lt;br&gt;services/reflection/plan_nudge.py,&lt;br&gt;просмотр раз в час и при старте; стимул&lt;br&gt;недоверенный" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_imp"><mxGeometry x="12" y="438.0" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="preg" value="&lt;b&gt;PeerRegistry&lt;/b&gt; [Адаптеры]&lt;br&gt;реестр участников шины: роль workspace&lt;br&gt;или service (из peers.yaml, манифест&lt;br&gt;главнее), режим владения shared или&lt;br&gt;owned, состояние, задачи, окружение&lt;br&gt;инструментов&lt;br&gt;→ Tool[]&lt;br&gt;сейчас: services/peers/registry.py:&lt;br&gt;PeerRecord (role, ownership, external),&lt;br&gt;записи объявляет agent/peers.yaml&lt;br&gt;(разделы workspaces, services,&lt;br&gt;planned), включённость в настройке&lt;br&gt;peers" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_in"><mxGeometry x="12" y="44" width="268" height="212.0" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;PeerHub (входящие)&lt;/b&gt; [Адаптеры]&lt;br&gt;WebSocket :8766 (/ws): рукопожатие (id&lt;br&gt;и role, манифест с role и ownership),&lt;br&gt;проверка формата, очередь входящих;&lt;br&gt;запросы core.*&lt;br&gt;→ Event&lt;br&gt;сейчас: services/peers/hub.py: приёмник&lt;br&gt;событий EventSink колбэком&lt;br&gt;(adapters/module_events.py), без&lt;br&gt;attention и fast_brain" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_in"><mxGeometry x="12" y="270.0" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="event" value="&lt;b&gt;Event&lt;/b&gt; [Домен]&lt;br&gt;единый конверт: kind, text, sender,&lt;br&gt;hint, data, trace, ts; источник внешний&lt;br&gt;или внутренний (self)&lt;br&gt;→ сущность&lt;br&gt;сейчас: частично (ТЗ 30):&lt;br&gt;kernel/event.py (Event с origin&lt;br&gt;external/self) для импульсов и&lt;br&gt;размышления; внутри внимания остаётся&lt;br&gt;Item (поле origin)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_in"><mxGeometry x="12" y="452.5" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="norm" value="&lt;b&gt;Normalizer&lt;/b&gt; [Сценарии]&lt;br&gt;нормализация, дедупликация за 60 с,&lt;br&gt;склейка повторов, TTL&lt;br&gt;→ Event&lt;br&gt;сейчас: выделен (ТЗ 29, R3):&lt;br&gt;services/attention/normalizer.py,&lt;br&gt;services/attention/items.py (хранилище&lt;br&gt;и склейка),&lt;br&gt;services/attention/dedupe.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_in"><mxGeometry x="12" y="635.0" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="people" value="&lt;b&gt;PeopleDirectory&lt;/b&gt; [Сценарии]&lt;br&gt;sender → Person, первый контакт,&lt;br&gt;заметки о человеке&lt;br&gt;→ Person&lt;br&gt;сейчас: выделен (R3):&lt;br&gt;Normalizer.note_sender через контракты&lt;br&gt;PeopleDirectory и MemoryWriter;&lt;br&gt;getattr(companion, "_rel") остался&lt;br&gt;только в адаптере adapters/people.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_in"><mxGeometry x="12" y="803.0" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;HardRules&lt;/b&gt; [Домен]&lt;br&gt;до моделей: R1 владелец → разговор, R2&lt;br&gt;ответ на вопрос, R3 mute, R4 критичное,&lt;br&gt;«замолчи»&lt;br&gt;→ RuleResult&lt;br&gt;сейчас: выделен (R3):&lt;br&gt;services/attention/pipeline.py&lt;br&gt;HardRules; чистые правила «замолчи» и&lt;br&gt;«похоже на просьбу» в&lt;br&gt;kernel/hard_rules.py; жёсткие правила&lt;br&gt;обращений владельца (ТЗ 25):&lt;br&gt;services/tools/routes.py +&lt;br&gt;services/tools/hard_rules.yaml, до&lt;br&gt;любых моделей: «замолчи» (в том числе&lt;br&gt;обрывок), ответ на вопрос о разрешении,&lt;br&gt;экстренные слова" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_dec"><mxGeometry x="12" y="44" width="268" height="255.5" as="geometry"/></mxCell><mxCell id="cls" value="&lt;b&gt;InputClassifier (контракт)&lt;/b&gt; [Сценарии]&lt;br&gt;намерение обращения владельца (chat,&lt;br&gt;action, stop...) до маршрутизатора;&lt;br&gt;события участников шины не&lt;br&gt;классифицирует; реализация: служба&lt;br&gt;GLiNER :8768, тайм-аут 2,5 с&lt;br&gt;→ InputClass&lt;br&gt;сейчас: services/classifier/decide.py +&lt;br&gt;services/decider; в Attention его зовёт&lt;br&gt;services/attention/input_classifier.py;&lt;br&gt;без сервиса обращение идёт по правилам" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_dec"><mxGeometry x="12" y="313.5" width="268" height="183.0" as="geometry"/></mxCell><mxCell id="attn" value="&lt;b&gt;EventAttention (контракт)&lt;/b&gt; [Сценарии]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;граница сервиса внимания: остальное&lt;br&gt;ядро знает его только через&lt;br&gt;`attention.Attention` и этот протокол&lt;br&gt;(приём событий, речь, правила, чтение&lt;br&gt;сводки, подключение при сборке:&lt;br&gt;connect, register_handler, set_*);&lt;br&gt;внутренние файлы папки снаружи не&lt;br&gt;импортируются&lt;br&gt;→ вызовы сервиса&lt;br&gt;сейчас: contracts.EventAttention;&lt;br&gt;services/attention/service.py; граница&lt;br&gt;проверяется test_attention_boundary.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;dashed=1;" vertex="1" parent="g_dec"><mxGeometry x="12" y="510.5" width="268" height="212.0" as="geometry"/></mxCell><mxCell id="disp" value="&lt;b&gt;Dispatcher&lt;/b&gt; [Сценарии]&lt;br&gt;решение по срочности участника шины: 0&lt;br&gt;выбросить (D0); ниже 4 во входящую&lt;br&gt;очередь (D1); 4 сказать (D3); 5 сказать&lt;br&gt;и поставить реакцию (D4). «Не&lt;br&gt;отвлекать» и «пользователь отошёл»&lt;br&gt;уводят в очередь; обращение к ней&lt;br&gt;поднимает до 4&lt;br&gt;→ Decision&lt;br&gt;сейчас:&lt;br&gt;services/attention/dispatcher.py&lt;br&gt;(finish, act), kernel/scoring.py&lt;br&gt;(decide: чистая функция),&lt;br&gt;services/attention/decision_log.py;&lt;br&gt;Normalizer.assign_urgency ставит&lt;br&gt;срочность по подсказке участника шины;&lt;br&gt;правила boost/only меняют её&lt;br&gt;(RuleStore.stance)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_dec"><mxGeometry x="12" y="736.5" width="268" height="284.5" as="geometry"/></mxCell><mxCell id="routes" value="&lt;b&gt;Routes&lt;/b&gt; [Домен]&lt;br&gt;маршруты события и обращения: reflex (с&lt;br&gt;already_done), chat, task, ignore,&lt;br&gt;think; таблица D0-D4 и R1-R4 →&lt;br&gt;маршруты; жёсткие правила из YAML&lt;br&gt;→ RouteDecision&lt;br&gt;сейчас: есть (ТЗ 25):&lt;br&gt;services/tools/routes.py,&lt;br&gt;services/tools/hard_rules.yaml" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_dec"><mxGeometry x="12" y="1035.0" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="conv" value="&lt;b&gt;ConversationService&lt;/b&gt; [Сценарии]&lt;br&gt;обращение владельца: жёсткие правила →&lt;br&gt;запись реплики → ответ на вопрос о&lt;br&gt;разрешении или передача единому агенту&lt;br&gt;→ Обращение агенту&lt;br&gt;сейчас:&lt;br&gt;services/conversation/service.py (фасад&lt;br&gt;Companion); жёсткие правила до моделей,&lt;br&gt;запись реплики в потоке (не задерживает&lt;br&gt;ответ), затем ResidentAgent.handle_user" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_conv"><mxGeometry x="12" y="44" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="ctx" value="&lt;b&gt;ContextBuilder&lt;/b&gt; [Сценарии]&lt;br&gt;собирает контекст: характер, память,&lt;br&gt;диалог, состояние; бюджет токенов на&lt;br&gt;роль&lt;br&gt;→ Context&lt;br&gt;сейчас: services/conversation/context_b&lt;br&gt;uilder.py: склейка 6 источников; бюджет&lt;br&gt;токенов на роль и блок и режимы push&lt;br&gt;(needs_memory) / pull (recall) в&lt;br&gt;настройке context, по умолчанию прежнее&lt;br&gt;поведение" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_conv"><mxGeometry x="12" y="226.5" width="268" height="183.0" as="geometry"/></mxCell><mxCell id="reply" value="&lt;b&gt;ReplyGenerator&lt;/b&gt; [Сценарии]&lt;br&gt;реплика по факту для очереди речи&lt;br&gt;(объявление, итог, вопрос участника&lt;br&gt;шины): LanguageModel(fast) → быстрая&lt;br&gt;модель (Claude без инструментов);&lt;br&gt;страховки стиля declutter&lt;br&gt;→ ReplyCandidate&lt;br&gt;сейчас: services/conversation/reply_gen&lt;br&gt;erator.py: speak_about (факт →&lt;br&gt;реплика), declutter; разговор с&lt;br&gt;владельцем ведёт ResidentAgent" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_conv"><mxGeometry x="12" y="423.5" width="268" height="183.0" as="geometry"/></mxCell><mxCell id="resident" value="&lt;b&gt;ResidentAgent&lt;/b&gt; [Сценарии]&lt;br&gt;единый агент: сообщение владельца,&lt;br&gt;событие, тревога и самоимпульс идут в&lt;br&gt;одну постоянную сессию через контракт&lt;br&gt;AgentRuntime (Claude SDK или pi,&lt;br&gt;настройка agent_runtime); инструменты&lt;br&gt;find_tools и call_tool описаны один раз&lt;br&gt;(ToolSpec) поверх реестра и&lt;br&gt;маршрутизатора (разрешения те же);&lt;br&gt;текст агента звучит по мере появления;&lt;br&gt;на среде, которая умеет steer (pi),&lt;br&gt;новое сообщение владельца и событие&lt;br&gt;подмешиваются в идущий ход&lt;br&gt;→ Reply и ToolResult&lt;br&gt;сейчас:&lt;br&gt;services/conversation/resident.py:&lt;br&gt;больше не знает про SDK; сброс после&lt;br&gt;сбоя; тревога обрывает ход (preempt),&lt;br&gt;на pi без сброса истории" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_conv"><mxGeometry x="12" y="620.5" width="268" height="299.0" as="geometry"/></mxCell><mxCell id="rtc" value="&lt;b&gt;AgentRuntime (контракт)&lt;/b&gt; [Адаптеры]&lt;br&gt;среда исполнения единого агента:&lt;br&gt;start(system, tools), run(prompt) -&gt;&lt;br&gt;события text / tool / end, steer,&lt;br&gt;abort, reset, close; can_steer&lt;br&gt;→ RuntimeEvent&lt;br&gt;сейчас: contracts.py: AgentRuntime,&lt;br&gt;ToolSpec, TextEvent, ToolEvent,&lt;br&gt;EndEvent" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_conv"><mxGeometry x="12" y="933.5" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="rtpi" value="&lt;b&gt;PiRuntime&lt;/b&gt; [Адаптеры]&lt;br&gt;pi по подписке ChatGPT: запускает мост&lt;br&gt;Node, говорит с ним строками JSON,&lt;br&gt;исполняет tool_call обработчиками&lt;br&gt;ToolSpec, steer и abort посреди хода,&lt;br&gt;история в resident_pi_session.json;&lt;br&gt;процесс умер: ход кончается ошибкой,&lt;br&gt;следующий поднимает мост заново&lt;br&gt;→ RuntimeEvent&lt;br&gt;сейчас: services/runtime/pi_runtime.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_conv"><mxGeometry x="12" y="1101.5" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="reflect" value="&lt;b&gt;ReflectionService&lt;/b&gt; [Сценарии]&lt;br&gt;внутренний диалог в несколько шагов;&lt;br&gt;запускают напоминание себе, итог&lt;br&gt;разговора и эпизода и пачка из входящей&lt;br&gt;очереди (inbox.batch); читает память;&lt;br&gt;лимиты шагов и токенов; сам переносит&lt;br&gt;созревшие мысли в память (consolidate)&lt;br&gt;→ Intent: сказать, сделать, напомнить,&lt;br&gt;записать, ничего&lt;br&gt;сейчас: есть (ТЗ 30):&lt;br&gt;services/reflection/reflection.py;&lt;br&gt;маршрут think из Dispatcher&lt;br&gt;(domain/rules.think_route) для self-&lt;br&gt;событий и итогов эпизодов, пачку шлёт&lt;br&gt;Inbox.tick; отдельного размышления в&lt;br&gt;простое и ThoughtConsolidator больше&lt;br&gt;нет (перенос мыслей внутри сервиса);&lt;br&gt;лимиты шагов, токенов, часа, глубины;&lt;br&gt;после разговора&lt;br&gt;(self.after_conversation) и эпизода&lt;br&gt;подводит итог: настроение и вывод&lt;br&gt;(IMP-10)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_think"><mxGeometry x="12" y="44.0" width="268" height="342.5" as="geometry"/></mxCell><mxCell id="thoughts" value="&lt;b&gt;Журнал мыслей&lt;/b&gt; [Адаптеры]&lt;br&gt;краткосрочная память: значимые&lt;br&gt;рассуждения с оценкой важности 1-5&lt;br&gt;(пустые и оборванные не пишутся),&lt;br&gt;важные переносятся в долговременную&lt;br&gt;память, мелкие забываются через сутки;&lt;br&gt;не озвучиваются&lt;br&gt;→ Thought&lt;br&gt;сейчас: есть (ТЗ 30):&lt;br&gt;services/reflection/store.py&lt;br&gt;(JsonThoughts, thoughts.json),&lt;br&gt;services/reflection/thoughts.py, GET&lt;br&gt;/api/thoughts, вкладка «Мысли» дашборда" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_think"><mxGeometry x="12" y="400.5" width="268" height="212.0" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;ToolRegistry&lt;/b&gt; [Сценарии]&lt;br&gt;инструменты ядра и окружений, видимость&lt;br&gt;по профилю, отбор по смыслу&lt;br&gt;→ Tool[]&lt;br&gt;сейчас: environments/registry.py,&lt;br&gt;services/tools/tool_search.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_act"><mxGeometry x="12" y="44" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;RiskPolicy + Approver&lt;/b&gt; [Домен]&lt;br&gt;риск auto / ask / public / danger;&lt;br&gt;вопрос пользователю, ответ да/нет&lt;br&gt;→ Approval&lt;br&gt;сейчас: router._step_inner +&lt;br&gt;services/conversation/approvals.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_act"><mxGeometry x="12" y="168.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="exec" value="&lt;b&gt;Executor (ToolInvoker)&lt;/b&gt; [Сценарии]&lt;br&gt;вызов инструмента в ядре или окружении,&lt;br&gt;коды ошибок, итог-факт&lt;br&gt;→ ToolResult&lt;br&gt;сейчас: router.run_tool_ex и _step:&lt;br&gt;проверка параметров, риск, вопрос о&lt;br&gt;разрешении, вызов" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_act"><mxGeometry x="12" y="293.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="jobs" value="&lt;b&gt;JobTracker&lt;/b&gt; [Сценарии]&lt;br&gt;долгие задачи: прогресс, вопросы, итог;&lt;br&gt;Модуль кода (Agent SDK)&lt;br&gt;→ JobState&lt;br&gt;сейчас: выделен (R3) для внимания:&lt;br&gt;services/attention/jobs.py&lt;br&gt;(JobTracker); peer_registry и&lt;br&gt;desktop.assistant_agent как раньше" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_act"><mxGeometry x="12" y="432.0" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="fmgr" value="&lt;b&gt;WorkspaceLink&lt;/b&gt; [Сценарии]&lt;br&gt;вход, выход и возобновление среды&lt;br&gt;окружения (workspace) по протоколу&lt;br&gt;workspace.enter / exit / resume; конец&lt;br&gt;задачи окружение сообщает флагом done в&lt;br&gt;статусе; один слот, checkpoint в&lt;br&gt;памяти; очереди событий, закрепления и&lt;br&gt;второго эшелона решений нет&lt;br&gt;→ Workspace&lt;br&gt;сейчас: services/spaces/link.py (вместо&lt;br&gt;менеджера фокуса ТЗ 18)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="44.0" width="268" height="183.0" as="geometry"/></mxCell><mxCell id="lease" value="&lt;b&gt;LeaseAdapter&lt;/b&gt; [Сценарии]&lt;br&gt;аренда общих пространств (контейнер с&lt;br&gt;интерфейсом управления, например&lt;br&gt;монтаж): acquire при входе агента,&lt;br&gt;release при выходе, занято: кто держит&lt;br&gt;и зачем; без срока и продления, сервис&lt;br&gt;сам отпускает при обрыве WebSocket;&lt;br&gt;состояние и описание (для чего и когда&lt;br&gt;переходить, GET /info) хранит сам&lt;br&gt;сервис, ядро читает их по запросу без&lt;br&gt;таймеров&lt;br&gt;→ Workspace&lt;br&gt;сейчас: services/spaces/lease.py&lt;br&gt;(gits_sdk.control.LeaseClient)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="241.0" width="268" height="226.5" as="geometry"/></mxCell><mxCell id="wsm" value="&lt;b&gt;WorkspaceManager&lt;/b&gt; [Сценарии]&lt;br&gt;в какой среде агент сейчас: assistant,&lt;br&gt;sleep и среды окружений из их&lt;br&gt;манифестов (rimworld, montage);&lt;br&gt;причина, цель, история. В среду&lt;br&gt;окружения входят только по импульсу&lt;br&gt;(сообщение, самоимпульс); события чужих&lt;br&gt;сред среду не переключают, они идут в&lt;br&gt;очередь речи и сводку&lt;br&gt;→ Workspace&lt;br&gt;сейчас: services/spaces/manager.py (ТЗ&lt;br&gt;32): поверх WorkspaceLink, сон приходит&lt;br&gt;от планировщика сна; инструменты&lt;br&gt;workspace.enter / exit / afk и&lt;br&gt;workspace.status, признак самоимпульса&lt;br&gt;services/reflection/origin.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="481.5" width="268" height="255.5" as="geometry"/></mxCell><mxCell id="wsdom" value="&lt;b&gt;WorkspaceRules&lt;/b&gt; [Домен]&lt;br&gt;чистые правила: кто и по какой причине&lt;br&gt;может войти в среду и выйти из неё&lt;br&gt;→ Workspace&lt;br&gt;сейчас: services/spaces/model.py (ТЗ&lt;br&gt;32)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_foc"><mxGeometry x="12" y="751.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="tsvc" value="&lt;b&gt;TaskService&lt;/b&gt; [Сценарии]&lt;br&gt;общие задачи всех сред: создание,&lt;br&gt;подзадачи, активная задача среды,&lt;br&gt;checkpoint при уходе и возобновление,&lt;br&gt;закрытие; события task.* в журнал&lt;br&gt;→ Task&lt;br&gt;сейчас: services/tasks/service.py (ТЗ&lt;br&gt;32, WS-8); сборка&lt;br&gt;services/tasks/wiring.py; инструменты&lt;br&gt;assistant.tasks, create_task,&lt;br&gt;close_task" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="875.5" width="268" height="183.0" as="geometry"/></mxCell><mxCell id="tdom" value="&lt;b&gt;TaskRules&lt;/b&gt; [Домен]&lt;br&gt;чистые правила задач: статусы,&lt;br&gt;следующий шаг, статус родителя по&lt;br&gt;подзадачам, можно ли прервать, какие&lt;br&gt;пора напомнить&lt;br&gt;→ Task&lt;br&gt;сейчас: services/tasks/model.py (ТЗ 32)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_foc"><mxGeometry x="12" y="1072.5" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="tplan" value="&lt;b&gt;Planner (задачи)&lt;/b&gt; [Сценарии]&lt;br&gt;цель → шаги через LanguageModel;&lt;br&gt;одинаков для всех сред, сама среда не&lt;br&gt;планирует&lt;br&gt;→ Step[]&lt;br&gt;сейчас: services/tasks/planner.py&lt;br&gt;(LlmPlanner), контракт Planner; промпт&lt;br&gt;planner в prompt.yaml" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="1211.5" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="npanel" value="&lt;b&gt;NodePanel&lt;/b&gt; [Сценарии]&lt;br&gt;панель узла рабочего места: пока агент&lt;br&gt;в среде окружения с деревом узлов, ядро&lt;br&gt;вызывает запросы nodes[].context и&lt;br&gt;кладёт ответ в контекст агента блоком&lt;br&gt;«Рабочее место» (без модели: факты даёт&lt;br&gt;окружение, ядро укладывает в бюджет и&lt;br&gt;показывает изменения); узел берётся из&lt;br&gt;state.node, видимость инструментов по&lt;br&gt;tools[].node, срочность по&lt;br&gt;nodes[].watch&lt;br&gt;→ Context block&lt;br&gt;сейчас: services/spaces/node_panel.py&lt;br&gt;(ТЗ 33),&lt;br&gt;core_service.wire_workspace_nodes;&lt;br&gt;правила: docs/WORKSPACE_MODULES.md" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="1365.0" width="268" height="255.5" as="geometry"/></mxCell><mxCell id="wloop" value="&lt;b&gt;WorkLoop&lt;/b&gt; [Сценарии]&lt;br&gt;автономная работа единого агента в&lt;br&gt;среде контентного окружения&lt;br&gt;(workspace.autonomous): пока агент&lt;br&gt;свободен, раз в work_interval_s шлёт&lt;br&gt;ему самоимпульс self.work_tick (маршрут&lt;br&gt;think); молчит при «не отвлекать»,&lt;br&gt;выключенной настройке autoplay, занятом&lt;br&gt;агенте и лимите Claude&lt;br&gt;→ self.work_tick&lt;br&gt;сейчас:&lt;br&gt;services/reflection/work_loop.py (ТЗ&lt;br&gt;33), core_service" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="1634.5" width="268" height="212.0" as="geometry"/></mxCell><mxCell id="tstore" value="&lt;b&gt;TaskStore&lt;/b&gt; [Адаптеры]&lt;br&gt;SQLite tasks.db в папке памяти&lt;br&gt;персонажа: дерево задач, напоминания и&lt;br&gt;планы как задачи&lt;br&gt;→ Task&lt;br&gt;сейчас: services/tasks/store.py (ТЗ&lt;br&gt;32), контракт TaskRepository" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_foc"><mxGeometry x="12" y="1860.5" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="queue" value="&lt;b&gt;SpeechQueue&lt;/b&gt; [Сценарии]&lt;br&gt;приоритеты, условия «не перебиваю»,&lt;br&gt;интервалы, прерывание, TTL; чистую&lt;br&gt;политику выбора выделить в домен позже&lt;br&gt;→ Utterance&lt;br&gt;сейчас:&lt;br&gt;services/attention/speech_queue.py: 296&lt;br&gt;строк, асинхронный координатор&lt;br&gt;(asyncio-задачи), в домен целиком не&lt;br&gt;переносится" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_out"><mxGeometry x="12" y="44" width="268" height="168.5" as="geometry"/></mxCell><mxCell id="digest" value="&lt;b&gt;Inbox + Digest&lt;/b&gt; [Сценарии]&lt;br&gt;одна входящая очередь на всех&lt;br&gt;участников шины: события срочности ниже&lt;br&gt;4 копятся с весом срочность × новизна&lt;br&gt;(редкий вид весит больше) × среда&lt;br&gt;(окружение текущей среды ×2, чужие&lt;br&gt;×0,5; полная очередь теряет самое&lt;br&gt;лёгкое, а не самое старое); когда есть&lt;br&gt;что-то заметное (2+) или много мелочи&lt;br&gt;(в пачку идут 10 самых весомых), модель&lt;br&gt;не занята, нет разговора, «не&lt;br&gt;отвлекать» выключено и прошла минута,&lt;br&gt;накопившееся уходит размышлению одним&lt;br&gt;событием inbox.batch&lt;br&gt;→ inbox.batch&lt;br&gt;сейчас: services/attention/inbox.py&lt;br&gt;(Inbox.tick из цикла внимания,&lt;br&gt;Inbox.blocker: почему пачка ждёт),&lt;br&gt;services/attention/digest.py (история&lt;br&gt;исходов события: ждёт, в контексте,&lt;br&gt;сказано, выброшено, вытеснено; peek&lt;br&gt;даёт самые весомые ждущие события в&lt;br&gt;контекст ответа); вкладка «Состояние»&lt;br&gt;показывает это через GET /api/buffer;&lt;br&gt;настройка&lt;br&gt;attention.inbox.min_interval_s; промпт&lt;br&gt;inbox в prompt.yaml; пачка&lt;br&gt;недоверенная: только сказать или&lt;br&gt;запомнить" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_out"><mxGeometry x="12" y="226.5" width="268" height="444.0" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;SpeechOutput и каналы (контракты)&lt;/b&gt; [Адаптеры]&lt;br&gt;голос (speak), чат, Telegram (deliver),&lt;br&gt;питомец&lt;br&gt;→ доставка&lt;br&gt;сейчас:&lt;br&gt;services/conversation/speech_out.py, se&lt;br&gt;rvices/conversation/conversation_io.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_out"><mxGeometry x="12" y="684.5" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="aff" value="&lt;b&gt;Presence и стикеры&lt;/b&gt; [Сценарии]&lt;br&gt;говорит ли, стикер, присутствие; эмоций&lt;br&gt;нет: стикер питомца выбирает тег в&lt;br&gt;тексте ответа (`[question]` перед&lt;br&gt;предложением), текст режется по тегам&lt;br&gt;на куски, каждый звучит со своим&lt;br&gt;стикером&lt;br&gt;→ PresenceState&lt;br&gt;сейчас:&lt;br&gt;services/conversation/stickers.py&lt;br&gt;(теги, разбор потока), services/convers&lt;br&gt;ation/reply_generator.py (куски&lt;br&gt;ответа), speech_out.PresenceTracker&lt;br&gt;(sticker, sticker_ts); GLiNER эмоции не&lt;br&gt;распознаёт, только решения" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_out"><mxGeometry x="12" y="823.5" width="268" height="241.0" as="geometry"/></mxCell><mxCell id="hubout" value="&lt;b&gt;PeerHub (исходящие)&lt;/b&gt; [Адаптеры]&lt;br&gt;доставка команд участникам шины:&lt;br&gt;tool.call, speak, workspace.enter,&lt;br&gt;job.answer&lt;br&gt;→ ToolResult, события&lt;br&gt;сейчас: services/peers/outbound.py:&lt;br&gt;Outbound (темы, presence с ограничением&lt;br&gt;частоты, job.answer), доступен как&lt;br&gt;PeerHub.outbound" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_out"><mxGeometry x="12" y="1078.5" width="268" height="154.0" as="geometry"/></mxCell><mxCell id="memsvc" value="&lt;b&gt;Сервис памяти (граница)&lt;/b&gt; [Сценарии]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;папка `services/memory_service/`: граф,&lt;br&gt;профиль, эпизоды, сон, дневник,&lt;br&gt;«запомни»; остальное ядро берёт из неё&lt;br&gt;только имена `__init__.py`&lt;br&gt;(GraphMemory, UserMemory,&lt;br&gt;EpisodeService, MemoryCapture,&lt;br&gt;адаптеры) и контракты&lt;br&gt;MemoryReader/MemoryWriter&lt;br&gt;→ вызовы сервиса&lt;br&gt;сейчас:&lt;br&gt;services/memory_service/__init__.py&lt;br&gt;(__all__); граница проверяется&lt;br&gt;test_memory_boundary.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;dashed=1;" vertex="1" parent="g_mem"><mxGeometry x="12" y="44.0" width="268" height="226.5" as="geometry"/></mxCell><mxCell id="mw" value="&lt;b&gt;MemoryWriter&lt;/b&gt; [Сценарии]&lt;br&gt;сразу: диалог и журнал; важное (оценка&lt;br&gt;4-5) в профиль владельца, планы в&lt;br&gt;задачи; в паузе: факты с оценкой&lt;br&gt;важности (Gemma + эмбеддинги); раз в 6&lt;br&gt;реплик: осмысление; во сне: факты&lt;br&gt;эпизодов в граф со ссылкой на эпизод&lt;br&gt;(ТЗ 27)&lt;br&gt;→ MemoryRecord&lt;br&gt;сейчас:&lt;br&gt;services/memory_service/capture.py:&lt;br&gt;_learn, _consolidate, remember_text +&lt;br&gt;GraphMemory.step" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_mem"><mxGeometry x="308" y="44.0" width="268" height="226.5" as="geometry"/></mxCell><mxCell id="mr" value="&lt;b&gt;MemoryReader&lt;/b&gt; [Сценарии]&lt;br&gt;профиль владельца (если говорит он) +&lt;br&gt;факты графа по теме; гибридный поиск&lt;br&gt;(search/) подключён: recall() ищет в&lt;br&gt;фактах, эпизодах и дневнике (ТЗ 27)&lt;br&gt;→ MemoryHit[]&lt;br&gt;сейчас: graph.profile_block (профиль&lt;br&gt;владельца, если говорит он),&lt;br&gt;graph.search, self_memories; search/:&lt;br&gt;HybridIndex (FTS5 + векторы +&lt;br&gt;свежесть), HybridSearch, переписывание&lt;br&gt;запроса, Embedder" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_mem"><mxGeometry x="604" y="44.0" width="268" height="226.5" as="geometry"/></mxCell><mxCell id="epi" value="&lt;b&gt;Эпизоды (нарезка + хранилище)&lt;/b&gt; [Сценарии]&lt;br&gt;журнал -&gt; эпизоды: границы без LLM&lt;br&gt;(пауза, фокус, задача, собеседник),&lt;br&gt;пики яркости, окно вокруг пика;&lt;br&gt;episodes.db со статусами и версиями&lt;br&gt;→ Episode&lt;br&gt;сейчас: есть (ТЗ 27):&lt;br&gt;services/memory_service/episodes.py, se&lt;br&gt;rvices/memory_service/episode_cutter.py&lt;br&gt;, services/memory_service/episode_store&lt;br&gt;.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_mem"><mxGeometry x="12" y="284.5" width="268" height="197.5" as="geometry"/></mxCell><mxCell id="sleep" value="&lt;b&gt;Режим сна (SleepScheduler + SleepRunner)&lt;/b&gt; [Сценарии]&lt;br&gt;фоновый режим памяти: при простое, по&lt;br&gt;расписанию, догоняющий; резюме от&lt;br&gt;первого лица с проверкой, факты в граф,&lt;br&gt;эмбеддинги, сводки, дневник;&lt;br&gt;прерывается между эпизодами&lt;br&gt;→ episode.summary, дневник&lt;br&gt;сейчас: есть (ТЗ 27):&lt;br&gt;services/memory_service/sleep.py, servi&lt;br&gt;ces/memory_service/sleep_scheduler.py,&lt;br&gt;services/memory_service/episode_summary&lt;br&gt;.py, services/memory_service/diary.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_mem"><mxGeometry x="308" y="284.5" width="268" height="197.5" as="geometry"/></mxCell><mxCell id="erecall" value="&lt;b&gt;EpisodeRecall&lt;/b&gt; [Сценарии]&lt;br&gt;поиск эпизодов и дневника по смыслу,&lt;br&gt;recall_episode(id) с разворотом до&lt;br&gt;событий, core.memory.episodes&lt;br&gt;→ MemoryHit[]&lt;br&gt;сейчас: есть (ТЗ 27): services/memory_s&lt;br&gt;ervice/episode_recall.py, services/memo&lt;br&gt;ry_service/episode_routes.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_mem"><mxGeometry x="604" y="284.5" width="268" height="197.5" as="geometry"/></mxCell><mxCell id="elog" value="&lt;b&gt;EventLog&lt;/b&gt; [Адаптеры]&lt;br&gt;SQLite events.db: журнал событий,&lt;br&gt;трасса, решения&lt;br&gt;→ контракт журнала&lt;br&gt;сейчас: services/tracing/events_log.py:&lt;br&gt;глобальные функции, 16 импортов" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="900" y="284.5" width="268" height="197.5" as="geometry"/></mxCell><mxCell id="stores" value="&lt;b&gt;Диалог, задачи, люди&lt;/b&gt; [Адаптеры]&lt;br&gt;JSON: диалог и активность; планы и&lt;br&gt;напоминания это задачи (tasks.db);&lt;br&gt;отношения&lt;br&gt;→ репозитории&lt;br&gt;сейчас:&lt;br&gt;services/memory_service/user.py,&lt;br&gt;services/tasks/store.py,&lt;br&gt;services/character/relationships.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="1196" y="284.5" width="268" height="197.5" as="geometry"/></mxCell><mxCell id="graph" value="&lt;b&gt;FactGraph (контракт)&lt;/b&gt; [Адаптеры]&lt;br&gt;SQLite graph.db&lt;br&gt;(services/memory_service/fact_store.py,&lt;br&gt;поиск через HybridIndex): факты с&lt;br&gt;интервалами валидности; области global&lt;br&gt;и &lt;id&gt;:&lt;область&gt; по профилю&lt;br&gt;(memory_service.scope.py, ТЗ 04&lt;br&gt;KB-12/13), в контексте до 3 фактов&lt;br&gt;→ контракт графа&lt;br&gt;сейчас:&lt;br&gt;services/memory_service/graph.py: 701&lt;br&gt;строка" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="1492" y="284.5" width="268" height="197.5" as="geometry"/></mxCell><mxCell id="char" value="&lt;b&gt;CharacterRepo&lt;/b&gt; [Адаптеры]&lt;br&gt;resources/&lt;Имя&gt;: конституция, prompt,&lt;br&gt;канон, голос; в контейнере вся папка&lt;br&gt;персонажа это том CHARACTER_HOME&lt;br&gt;(ресурсы и memory/)&lt;br&gt;→ Character&lt;br&gt;сейчас: services/character/character.py&lt;br&gt;+ resources/" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="1788" y="284.5" width="268" height="197.5" as="geometry"/></mxCell><mxCell id="lms" value="&lt;b&gt;LM Studio :1234&lt;/b&gt; [Внешнее]&lt;br&gt;EmbeddingGemma (поиск) и разбор&lt;br&gt;фактов графа (Gemma); ответов и&lt;br&gt;планов в нём больше нет" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="12" y="44.0" width="226" height="154.0" as="geometry"/></mxCell><mxCell id="gli" value="&lt;b&gt;GLiNER decider :8768&lt;/b&gt; [Внешнее]&lt;br&gt;классификатор событий и&lt;br&gt;обращений" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="252" y="44.0" width="226" height="154.0" as="geometry"/></mxCell><mxCell id="fish" value="&lt;b&gt;ESpeech :8771 / Fish Speech / edge-tts&lt;/b&gt; [Внешнее]&lt;br&gt;синтез речи (F5-TTS, русский)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="492" y="44.0" width="226" height="154.0" as="geometry"/></mxCell><mxCell id="bridge" value="&lt;b&gt;services/agent-runtime (Node)&lt;/b&gt; [Внешнее]&lt;br&gt;мост к pi-agent-core: процесс&lt;br&gt;Node, протокол строк JSON по&lt;br&gt;stdin и stdout; модель по&lt;br&gt;подписке ChatGPT (вход auth.json&lt;br&gt;вручную)&lt;br&gt;сейчас: services/agent-&lt;br&gt;runtime/bridge.mjs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="732" y="44.0" width="226" height="154.0" as="geometry"/></mxCell><mxCell id="sup" value="&lt;b&gt;Supervisor&lt;/b&gt; [Адаптеры]&lt;br&gt;запуск и перезапуск процессов&lt;br&gt;участников шины (окружения и&lt;br&gt;сервисы из peers.yaml)&lt;br&gt;сейчас: host/supervisor.py: 573&lt;br&gt;строки; режим «только ядро»&lt;br&gt;(GITS_NO_MODULES=1 или настройка&lt;br&gt;only_core); устойчивость ядра&lt;br&gt;проверяет tools/soak_core.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_ext"><mxGeometry x="972" y="44.0" width="226" height="154.0" as="geometry"/></mxCell><mxCell id="root" value="&lt;b&gt;Composition root&lt;/b&gt; [Адаптеры]&lt;br&gt;только собирает объекты и&lt;br&gt;подставляет контракты; бизнес-&lt;br&gt;логики быть не должно&lt;br&gt;сейчас: core_service.py: только&lt;br&gt;сборка; обработчики voice,&lt;br&gt;colonists, run_lost в&lt;br&gt;app/handlers/" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_ext"><mxGeometry x="1212" y="44.0" width="226" height="154.0" as="geometry"/></mxCell><mxCell id="hnd" value="&lt;b&gt;Обработчики участников&lt;/b&gt; [Сценарии]&lt;br&gt;события voice.*,&lt;br&gt;rimworld.colonists и run_ended,&lt;br&gt;desktop.activity, события игры&lt;br&gt;как данные&lt;br&gt;сейчас: app/handlers/: voice.py,&lt;br&gt;game.py, desktop.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_ext"><mxGeometry x="1452" y="44.0" width="226" height="154.0" as="geometry"/></mxCell><mxCell id="e1" value="Event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="voice" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="desk" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="tg" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="strm" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="кто подключён" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#2b6fba;fontSize=9;" edge="1" parent="1" source="hub" target="preg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="rim" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="job.update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="mont" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="UserInput" style="edgeStyle=orthogonalEdgeStyle;