<mxfile host="app.diagrams.net"><diagram name="Целевая архитектура ядра GitS" id="arch1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2062" pageHeight="1738" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g1" value="1. Источники событий&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;внешний слой: модули и интерфейсы&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="292" height="872.0" as="geometry"/></mxCell><mxCell id="g2" value="2. Транспорт и приём&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;адаптер шины + нормализация&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="372" y="140" width="292" height="585.5" as="geometry"/></mxCell><mxCell id="g3" value="3. Решение: что делать с событием&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;сценарий ProcessEvent&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="714" y="140" width="292" height="600.0" as="geometry"/></mxCell><mxCell id="g4a" value="4a. Диалог&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;сценарии разговора&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1056" y="140" width="292" height="585.5" as="geometry"/></mxCell><mxCell id="g4c" value="4b. Фокус&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;кто сейчас главный&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1056" y="751.5" width="292" height="403.0" as="geometry"/></mxCell><mxCell id="g4b" value="4c. Дела&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;планирование и выполнение&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1398" y="140" width="292" height="652.0" as="geometry"/></mxCell><mxCell id="g5" value="5. Вывод&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;политика речи и каналы&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1740" y="140" width="292" height="666.5" as="geometry"/></mxCell><mxCell id="g6" value="6. Память&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;запись и чтение; источник правды: журнал событий&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="714" y="1200.5" width="884" height="307.5" as="geometry"/></mxCell><mxCell id="g7" value="7. Внешний слой&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;службы и модели&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1544.0" width="1938" height="154.0" as="geometry"/></mxCell><mxCell id="voice" value="&lt;b&gt;voice&lt;/b&gt; [Адаптеры]&lt;br&gt;микрофон, VAD, распознавание речи&lt;br&gt;(WhisperX), узнавание голоса; озвучка&lt;br&gt;(Fish Speech)&lt;br&gt;→ Event voice.utterance, voice.speech&lt;br&gt;сейчас: modules/voice" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g1"><mxGeometry x="12" y="44" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="desk" value="&lt;b&gt;desktop&lt;/b&gt; [Адаптеры]&lt;br&gt;экран, активность, мышь и клавиатура,&lt;br&gt;Claude-помощник&lt;br&gt;→ Event desktop.*, job.update&lt;br&gt;сейчас: modules/desktop" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g1"><mxGeometry x="12" y="168.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="tg" value="&lt;b&gt;telegram&lt;/b&gt; [Адаптеры]&lt;br&gt;бот, её аккаунт, посты канала&lt;br&gt;→ Event telegram.*&lt;br&gt;сейчас: modules/telegram" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g1"><mxGeometry x="12" y="278.5" width="268" height="81.5" as="geometry"/></mxCell><mxCell id="rim" value="&lt;b&gt;rimworld&lt;/b&gt; [Адаптеры]&lt;br&gt;игровой агент: ходы, комментатор,&lt;br&gt;запись забега&lt;br&gt;→ Event raid, death, colonists,&lt;br&gt;run_ended&lt;br&gt;сейчас: modules/rimworld" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g1"><mxGeometry x="12" y="374.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="mont" value="&lt;b&gt;montage&lt;/b&gt; [Адаптеры]&lt;br&gt;конвейер роликов: Remotion + ffmpeg,&lt;br&gt;агент Claude&lt;br&gt;→ job.update, вопросы пользователю&lt;br&gt;сейчас: modules/montage" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g1"><mxGeometry x="12" y="498.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="dash" value="&lt;b&gt;Дашборд и чат&lt;/b&gt; [Адаптеры]&lt;br&gt;чат, настройки, пульт, оценки&lt;br&gt;→ UserInput как Event источника&lt;br&gt;dashboard&lt;br&gt;сейчас: dashboard.py: 863 строки, 58&lt;br&gt;функций, 0 классов, ходит в хранилища&lt;br&gt;напрямую" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g1"><mxGeometry x="12" y="608.5" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="sched" value="&lt;b&gt;Планировщик времени&lt;/b&gt; [Адаптеры]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;тики проактивности, сроки, (план) режим&lt;br&gt;сна&lt;br&gt;→ Event system.tick&lt;br&gt;сейчас: циклы разбросаны по companion,&lt;br&gt;attention, focus" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;dashed=1;" vertex="1" parent="g1"><mxGeometry x="12" y="747.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;ModuleHub&lt;/b&gt; [Адаптеры]&lt;br&gt;WebSocket :8766: рукопожатие, проверка&lt;br&gt;формата, очередь входящих, запросы&lt;br&gt;core.*&lt;br&gt;→ Event, ToolResult&lt;br&gt;сейчас: module_hub.py: 683 строки;&lt;br&gt;импортирует attention и fast_brain, то&lt;br&gt;есть транспорт знает домен" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g2"><mxGeometry x="12" y="44" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="event" value="&lt;b&gt;Event&lt;/b&gt; [Домен]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;единый конверт: kind, text, sender,&lt;br&gt;hint, data, trace, ts&lt;br&gt;→ сущность&lt;br&gt;сейчас: нет: dict, Item, UserInput и&lt;br&gt;SpeechCandidate по отдельности" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;dashed=1;" vertex="1" parent="g2"><mxGeometry x="12" y="197.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="norm" value="&lt;b&gt;Normalizer&lt;/b&gt; [Сценарии]&lt;br&gt;нормализация, дедупликация за 60 с,&lt;br&gt;склейка повторов, TTL&lt;br&gt;→ Event&lt;br&gt;сейчас: attention.submit и&lt;br&gt;_merge_duplicate" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g2"><mxGeometry x="12" y="322.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="people" value="&lt;b&gt;PeopleDirectory&lt;/b&gt; [Сценарии]&lt;br&gt;sender → Person, первый контакт,&lt;br&gt;заметки о человеке&lt;br&gt;→ Person&lt;br&gt;сейчас: attention._note_sender +&lt;br&gt;relationships; лезет в companion._rel&lt;br&gt;через getattr" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g2"><mxGeometry x="12" y="446.5" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;HardRules&lt;/b&gt; [Домен]&lt;br&gt;до моделей: R1 владелец → разговор, R2&lt;br&gt;ответ на вопрос, R3 mute, R4 критичное,&lt;br&gt;«замолчи»&lt;br&gt;→ RuleResult&lt;br&gt;сейчас: середина attention.submit;&lt;br&gt;стоп-фразы и «похоже на просьбу» ещё в&lt;br&gt;двух местах" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g3"><mxGeometry x="12" y="44" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="cls" value="&lt;b&gt;Classifier (порт)&lt;/b&gt; [Сценарии]&lt;br&gt;категория, срочность, адресат, нужен ли&lt;br&gt;фокус; реализация: служба GLiNER :8768;&lt;br&gt;тайм-аут 1 с; без неё подсказки модуля&lt;br&gt;→ Classification&lt;br&gt;сейчас: decide.py + служба&lt;br&gt;services/decider (GLiNER)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g3"><mxGeometry x="12" y="197.5" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="score" value="&lt;b&gt;PriorityScorer&lt;/b&gt; [Домен]&lt;br&gt;срочность × 20 × веса (профиль,&lt;br&gt;отправитель, правила, пользователь) ×&lt;br&gt;свежесть&lt;br&gt;→ priority 0..100&lt;br&gt;сейчас: attention._score" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g3"><mxGeometry x="12" y="336.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="disp" value="&lt;b&gt;Dispatcher&lt;/b&gt; [Сценарии]&lt;br&gt;решение D0–D4 и routes[]: say, chat,&lt;br&gt;task, focus, digest, ignore; пишет&lt;br&gt;решение в журнал&lt;br&gt;→ Decision&lt;br&gt;сейчас: attention._decide, _act,&lt;br&gt;_finish" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g3"><mxGeometry x="12" y="461.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="conv" value="&lt;b&gt;ConversationService&lt;/b&gt; [Сценарии]&lt;br&gt;обращение владельца: проверки → ветка&lt;br&gt;(болтовня / просьба / «что умеешь») →&lt;br&gt;ответ&lt;br&gt;→ Reply или Task&lt;br&gt;сейчас: companion._handle_text и&lt;br&gt;_converse" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g4a"><mxGeometry x="12" y="44" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="ctx" value="&lt;b&gt;ContextBuilder&lt;/b&gt; [Сценарии]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;собирает контекст: характер, память,&lt;br&gt;диалог, состояние; бюджет токенов на&lt;br&gt;роль&lt;br&gt;→ Context&lt;br&gt;сейчас: нет: companion._context&lt;br&gt;склеивает 6 строк без бюджета" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;dashed=1;" vertex="1" parent="g4a"><mxGeometry x="12" y="183.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="reply" value="&lt;b&gt;ReplyGenerator&lt;/b&gt; [Сценарии]&lt;br&gt;LanguageModel(fast) → LM Studio&lt;br&gt;(Gemma): ответ; страховки стиля (убрать&lt;br&gt;навязчивое)&lt;br&gt;→ ReplyCandidate&lt;br&gt;сейчас: companion._converse, _declutter&lt;br&gt;+ fast_brain" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g4a"><mxGeometry x="12" y="322.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="pro" value="&lt;b&gt;ProactiveService&lt;/b&gt; [Сценарии]&lt;br&gt;по тику Планировщика (30 с) сама&lt;br&gt;решает, стоит ли заговорить&lt;br&gt;→ SpeechCandidate&lt;br&gt;сейчас: companion.proactive_loop и&lt;br&gt;_maybe_speak" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g4a"><mxGeometry x="12" y="461.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="fmgr" value="&lt;b&gt;FocusManager&lt;/b&gt; [Сценарии]&lt;br&gt;один слот, очередь, переключение,&lt;br&gt;дребезг, checkpoint&lt;br&gt;→ FocusDecision&lt;br&gt;сейчас: focus.py: 1061 строка, 60&lt;br&gt;методов в одном классе" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g4c"><mxGeometry x="12" y="44.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="fpol" value="&lt;b&gt;FocusPolicy&lt;/b&gt; [Домен]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;чистые правила: приоритет, запас,&lt;br&gt;критичное, старение, конфликты&lt;br&gt;→ FocusDecision&lt;br&gt;сейчас: внутри FocusManager: _gate,&lt;br&gt;_near, _claimant, _conflict" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;dashed=1;" vertex="1" parent="g4c"><mxGeometry x="12" y="168.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="fdisp" value="&lt;b&gt;FocusDispatch (порт)&lt;/b&gt; [Сценарии]&lt;br&gt;Gemma только для неоднозначного; ответ&lt;br&gt;строго проверяется&lt;br&gt;→ Op&lt;br&gt;сейчас: focus_dispatch.py: 288 строк" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g4c"><mxGeometry x="12" y="293.0" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;ToolRegistry&lt;/b&gt; [Сценарии]&lt;br&gt;инструменты ядра и модулей, видимость&lt;br&gt;по профилю, отбор по смыслу&lt;br&gt;→ Tool[]&lt;br&gt;сейчас: environments/registry.py,&lt;br&gt;tool_search.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g4b"><mxGeometry x="12" y="44" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b&gt;Planner&lt;/b&gt; [Сценарии]&lt;br&gt;LanguageModel → LM Studio (Gemma): план&lt;br&gt;шагов или «не могу»&lt;br&gt;→ Plan&lt;br&gt;сейчас: router._plan" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g4b"><mxGeometry x="12" y="168.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;RiskPolicy + Approver&lt;/b&gt; [Домен]&lt;br&gt;риск auto / ask / public / danger;&lt;br&gt;вопрос пользователю, ответ да/нет&lt;br&gt;→ Approval&lt;br&gt;сейчас: router._step + approvals.py:&lt;br&gt;301 строка" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g4b"><mxGeometry x="12" y="278.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="exec" value="&lt;b&gt;Executor (ToolInvoker)&lt;/b&gt; [Сценарии]&lt;br&gt;вызов инструмента в ядре или модуле,&lt;br&gt;коды ошибок, итог-факт&lt;br&gt;→ ToolResult&lt;br&gt;сейчас: router._step и _run_step" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g4b"><mxGeometry x="12" y="403.0" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="jobs" value="&lt;b&gt;JobTracker&lt;/b&gt; [Сценарии]&lt;br&gt;долгие задачи: прогресс, вопросы, итог;&lt;br&gt;Claude-помощник (Agent SDK)&lt;br&gt;→ JobState&lt;br&gt;сейчас: module_registry +&lt;br&gt;attention.on_job_update +&lt;br&gt;desktop.assistant_agent" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g4b"><mxGeometry x="12" y="513.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="queue" value="&lt;b&gt;SpeechQueue&lt;/b&gt; [Домен]&lt;br&gt;приоритеты, условия «не перебиваю»,&lt;br&gt;интервалы, прерывание, TTL&lt;br&gt;→ Utterance&lt;br&gt;сейчас: speech_queue.py: 296 строк, уже&lt;br&gt;чистый класс без зависимостей" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g5"><mxGeometry x="12" y="44" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="digest" value="&lt;b&gt;Digest&lt;/b&gt; [Сценарии]&lt;br&gt;сводка событий D1 и предложение&lt;br&gt;рассказать&lt;br&gt;→ SpeechCandidate&lt;br&gt;сейчас: attention._digest_*" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g5"><mxGeometry x="12" y="168.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;SpeechOutput и каналы (порты)&lt;/b&gt; [Адаптеры]&lt;br&gt;голос (speak), чат, Telegram (deliver),&lt;br&gt;питомец&lt;br&gt;→ доставка&lt;br&gt;сейчас: speech_out.py,&lt;br&gt;conversation_io.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g5"><mxGeometry x="12" y="278.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="aff" value="&lt;b&gt;Presence и эмоции&lt;/b&gt; [Сценарии]&lt;br&gt;говорит ли, эмоция, присутствие; (план)&lt;br&gt;настроение&lt;br&gt;→ PresenceState&lt;br&gt;сейчас: PresenceTracker +&lt;br&gt;fast_brain.publish" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g5"><mxGeometry x="12" y="403.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="hubout" value="&lt;b&gt;ModuleHub: исходящие&lt;/b&gt; [Адаптеры]&lt;br&gt;доставка команд модулям-источникам&lt;br&gt;(слева): tool.call, speak,&lt;br&gt;policy.activate, job.answer&lt;br&gt;→ ToolResult, события voice.speech&lt;br&gt;сейчас: тот же module_hub.py, смешан с&lt;br&gt;приёмом" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g5"><mxGeometry x="12" y="527.5" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="mw" value="&lt;b&gt;MemoryWriter&lt;/b&gt; [Сценарии]&lt;br&gt;сразу: диалог и журнал; в паузе: факты&lt;br&gt;(Gemma + эмбеддинги); раз в 6 реплик:&lt;br&gt;осмысление; (план) эпизоды и сон&lt;br&gt;→ MemoryRecord&lt;br&gt;сейчас: companion._learn, _consolidate&lt;br&gt;+ graph_memory.step" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g6"><mxGeometry x="12" y="44.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="mr" value="&lt;b&gt;MemoryReader&lt;/b&gt; [Сценарии]&lt;br&gt;граф + воспоминания о себе + записи;&lt;br&gt;(план) гибридный поиск&lt;br&gt;→ MemoryHit[]&lt;br&gt;сейчас: graph.search, self_memories,&lt;br&gt;MemoryStore.relevant (два разных&lt;br&gt;поиска)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g6"><mxGeometry x="308" y="44.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="elog" value="&lt;b&gt;EventLog&lt;/b&gt; [Адаптеры]&lt;br&gt;SQLite events.db: журнал событий,&lt;br&gt;трасса, решения&lt;br&gt;→ порт журнала&lt;br&gt;сейчас: events_log.py: глобальные&lt;br&gt;функции, 16 импортов" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g6"><mxGeometry x="604" y="44.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="stores" value="&lt;b&gt;Диалог, записи, люди&lt;/b&gt; [Адаптеры]&lt;br&gt;JSON: диалог, MemoryStore (планы,&lt;br&gt;напоминания), отношения&lt;br&gt;→ репозитории&lt;br&gt;сейчас: user_memory.py,&lt;br&gt;memory_store.py, relationships.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g6"><mxGeometry x="12" y="183.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="graph" value="&lt;b&gt;FactGraph (порт)&lt;/b&gt; [Адаптеры]&lt;br&gt;Graphiti: факты с интервалами&lt;br&gt;валидности&lt;br&gt;→ порт графа&lt;br&gt;сейчас: graph_memory.py: 701 строка" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g6"><mxGeometry x="308" y="183.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="char" value="&lt;b&gt;CharacterRepo&lt;/b&gt; [Адаптеры]&lt;br&gt;resources/&lt;Имя&gt;: конституция, prompt,&lt;br&gt;канон, голос&lt;br&gt;→ Character&lt;br&gt;сейчас: character.py + resources/" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g6"><mxGeometry x="604" y="183.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="lms" value="&lt;b&gt;LM Studio :1234&lt;/b&gt; [Внешнее]&lt;br&gt;Gemma (речь, план, факты) и&lt;br&gt;EmbeddingGemma" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g7"><mxGeometry x="12" y="44.0" width="226" height="96.0" as="geometry"/></mxCell><mxCell id="gli" value="&lt;b&gt;GLiNER decider :8768&lt;/b&gt; [Внешнее]&lt;br&gt;классификатор событий и&lt;br&gt;обращений" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g7"><mxGeometry x="252" y="44.0" width="226" height="96.0" as="geometry"/></mxCell><mxCell id="falk" value="&lt;b&gt;FalkorDB :6380&lt;/b&gt; [Внешнее]&lt;br&gt;база графа фактов" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g7"><mxGeometry x="492" y="44.0" width="226" height="96.0" as="geometry"/></mxCell><mxCell id="fish" value="&lt;b&gt;Fish Speech / edge-tts&lt;/b&gt; [Внешнее]&lt;br&gt;синтез речи" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g7"><mxGeometry x="732" y="44.0" width="226" height="96.0" as="geometry"/></mxCell><mxCell id="wx" value="&lt;b&gt;WhisperX / Whisper&lt;/b&gt; [Внешнее]&lt;br&gt;распознавание речи" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g7"><mxGeometry x="972" y="44.0" width="226" height="96.0" as="geometry"/></mxCell><mxCell id="cl" value="&lt;b&gt;Claude Agent SDK&lt;/b&gt; [Внешнее]&lt;br&gt;долгие и сложные задачи" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g7"><mxGeometry x="1212" y="44.0" width="226" height="96.0" as="geometry"/></mxCell><mxCell id="sup" value="&lt;b&gt;Supervisor&lt;/b&gt; [Адаптеры]&lt;br&gt;запуск и перезапуск процессов&lt;br&gt;модулей&lt;br&gt;сейчас: supervisor.py: 573&lt;br&gt;строки" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g7"><mxGeometry x="1452" y="44.0" width="226" height="96.0" as="geometry"/></mxCell><mxCell id="ffm" value="&lt;b&gt;Remotion + ffmpeg&lt;/b&gt; [Внешнее]&lt;br&gt;рендер и запись" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g7"><mxGeometry x="1692" y="44.0" width="226" height="96.0" as="geometry"/></mxCell><mxCell id="root" value="&lt;b&gt;Composition root: core_service.py&lt;/b&gt;&lt;br&gt;только собирает объекты и подставляет порты в сценарии; бизнес-логики быть не должно&lt;br&gt;сейчас: сейчас 378 строк и 22 импорта; внутри обработчики voice, colonists, run_lost и game_order" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="1"><mxGeometry x="42" y="40" width="1978" height="62" as="geometry"/></mxCell><mxCell id="e1" value="1. Event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="voice" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="1. " style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="desk" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1. " style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="tg" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="1. " style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="rim" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="1. job.update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="mont" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="1. UserInput" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="dash" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="system.tick" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="sched" target="norm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="2. Event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="hub" target="norm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="sender" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#2b6fba;fontSize=9;" edge="1" parent="1" source="norm" target="people"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="3. Event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="norm" target="rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="4. не решено правилами" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="rules" target="cls"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="5. Classification" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="cls" target="score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="6. priority" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="score" target="disp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="R1: владелец" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="rules" target="conv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="7. route chat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="disp" target="conv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="7. route task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="disp" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="7. route focus" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="disp" target="fmgr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="7. route say: факт" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" sou