<mxfile host="app.diagrams.net"><diagram name="Архитектура ядра GitS: всё вместе" id="arch2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2062" pageHeight="1960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g_src" value="Источники событий" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="292" height="704.0" as="geometry"/></mxCell><mxCell id="g_imp" value="Внутренние импульсы" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="766.0" width="292" height="307.5" as="geometry"/></mxCell><mxCell id="g_in" value="Приём" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="372" y="40" width="292" height="600.0" as="geometry"/></mxCell><mxCell id="g_dec" value="Решение" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="714" y="40" width="292" height="585.5" as="geometry"/></mxCell><mxCell id="g_conv" value="Разговор" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1056" y="40" width="292" height="461.0" as="geometry"/></mxCell><mxCell id="g_think" value="Размышление" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1056" y="523.0" width="292" height="322.0" as="geometry"/></mxCell><mxCell id="g_act" value="Дела" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1398" y="40" width="292" height="652.0" as="geometry"/></mxCell><mxCell id="g_foc" value="Фокус" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1398" y="714.0" width="292" height="637.5" as="geometry"/></mxCell><mxCell id="g_out" value="Вывод" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1740" y="40" width="292" height="681.0" as="geometry"/></mxCell><mxCell id="g_mem" value="Память" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="714" y="1383.5" width="884" height="322.0" as="geometry"/></mxCell><mxCell id="g_ext" value="Внешний слой и сборка" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f7f8fa;strokeColor=#b6bdc8;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1727.5" width="1938" height="183.0" as="geometry"/></mxCell><mxCell id="voice" value="&lt;b&gt;voice&lt;/b&gt; [Адаптеры]&lt;br&gt;микрофон, VAD, распознавание речи&lt;br&gt;(WhisperX), узнавание голоса; озвучка&lt;br&gt;(Fish Speech)&lt;br&gt;→ Event voice.utterance&lt;br&gt;сейчас: modules/voice" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="44" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="desk" value="&lt;b&gt;desktop&lt;/b&gt; [Адаптеры]&lt;br&gt;экран, активность, мышь и клавиатура,&lt;br&gt;Claude-помощник&lt;br&gt;→ Event desktop.*, job.update&lt;br&gt;сейчас: modules/desktop" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="168.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="tg" value="&lt;b&gt;telegram&lt;/b&gt; [Адаптеры]&lt;br&gt;бот, её аккаунт, посты канала&lt;br&gt;→ Event telegram.*&lt;br&gt;сейчас: modules/telegram" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="278.5" width="268" height="81.5" as="geometry"/></mxCell><mxCell id="rim" value="&lt;b&gt;rimworld&lt;/b&gt; [Адаптеры]&lt;br&gt;игровой агент: ходы, комментатор,&lt;br&gt;запись забега&lt;br&gt;→ Event raid, death, colonists&lt;br&gt;сейчас: modules/rimworld" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="374.0" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="mont" value="&lt;b&gt;montage&lt;/b&gt; [Адаптеры]&lt;br&gt;конвейер роликов: Remotion + ffmpeg,&lt;br&gt;агент Claude&lt;br&gt;→ job.update, вопросы&lt;br&gt;сейчас: modules/montage" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="484.0" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="dash" value="&lt;b&gt;Дашборд и чат&lt;/b&gt; [Адаптеры]&lt;br&gt;чат, настройки, пульт, оценки&lt;br&gt;→ UserInput как Event&lt;br&gt;сейчас: dashboard.py: 863 строки, 0&lt;br&gt;классов, ходит в хранилища напрямую" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_src"><mxGeometry x="12" y="594.0" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="reminders" value="&lt;b&gt;ReminderStore&lt;/b&gt; [Адаптеры]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;напоминания, назначенные самим агентом:&lt;br&gt;срок, текст, откуда пришла мысль&lt;br&gt;→ срок наступил&lt;br&gt;сейчас: нет: сейчас есть только план в&lt;br&gt;MemoryStore с сроком" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;dashed=1;" vertex="1" parent="g_imp"><mxGeometry x="12" y="44.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="timer" value="&lt;b&gt;ImpulseTimer&lt;/b&gt; [Адаптеры]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;следит только за сроками напоминаний;&lt;br&gt;когда срок пришёл, шлёт событие. Не тик&lt;br&gt;болтовни&lt;br&gt;→ Event self.reminder&lt;br&gt;сейчас: нет: сейчас proactive_loop раз&lt;br&gt;в 30 с" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;dashed=1;" vertex="1" parent="g_imp"><mxGeometry x="12" y="168.5" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;ModuleHub (входящие)&lt;/b&gt; [Адаптеры]&lt;br&gt;WebSocket :8766: рукопожатие, проверка&lt;br&gt;формата, очередь входящих; запросы&lt;br&gt;core.*&lt;br&gt;→ Event&lt;br&gt;сейчас: module_hub.py: 683 строки;&lt;br&gt;импортирует attention и fast_brain, то&lt;br&gt;есть транспорт знает домен" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_in"><mxGeometry x="12" y="44" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="event" value="&lt;b&gt;Event&lt;/b&gt; [Домен]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;единый конверт: kind, text, sender,&lt;br&gt;hint, data, trace, ts; источник внешний&lt;br&gt;или внутренний (self)&lt;br&gt;→ сущность&lt;br&gt;сейчас: нет: dict, Item, UserInput и&lt;br&gt;SpeechCandidate по отдельности" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;dashed=1;" vertex="1" parent="g_in"><mxGeometry x="12" y="197.5" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="norm" value="&lt;b&gt;Normalizer&lt;/b&gt; [Сценарии]&lt;br&gt;нормализация, дедупликация за 60 с,&lt;br&gt;склейка повторов, TTL&lt;br&gt;→ Event&lt;br&gt;сейчас: attention.submit и&lt;br&gt;_merge_duplicate" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_in"><mxGeometry x="12" y="336.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="people" value="&lt;b&gt;PeopleDirectory&lt;/b&gt; [Сценарии]&lt;br&gt;sender → Person, первый контакт,&lt;br&gt;заметки о человеке&lt;br&gt;→ Person&lt;br&gt;сейчас: attention._note_sender +&lt;br&gt;relationships; лезет в companion._rel&lt;br&gt;через getattr" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_in"><mxGeometry x="12" y="461.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;HardRules&lt;/b&gt; [Домен]&lt;br&gt;до моделей: R1 владелец → разговор, R2&lt;br&gt;ответ на вопрос, R3 mute, R4 критичное,&lt;br&gt;«замолчи»&lt;br&gt;→ RuleResult&lt;br&gt;сейчас: середина attention.submit;&lt;br&gt;стоп-фразы и «похоже на просьбу» ещё и&lt;br&gt;в router" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_dec"><mxGeometry x="12" y="44" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="cls" value="&lt;b&gt;Classifier (контракт)&lt;/b&gt; [Сценарии]&lt;br&gt;категория, срочность, адресат, нужен ли&lt;br&gt;фокус; реализация: служба GLiNER :8768;&lt;br&gt;тайм-аут 1 с&lt;br&gt;→ Classification&lt;br&gt;сейчас: decide.py + services/decider" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_dec"><mxGeometry x="12" y="197.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="score" value="&lt;b&gt;PriorityScorer&lt;/b&gt; [Домен]&lt;br&gt;срочность × 20 × веса (профиль,&lt;br&gt;отправитель, правила, пользователь) ×&lt;br&gt;свежесть&lt;br&gt;→ priority 0..100&lt;br&gt;сейчас: attention._score" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_dec"><mxGeometry x="12" y="322.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="disp" value="&lt;b&gt;Dispatcher&lt;/b&gt; [Сценарии]&lt;br&gt;решение D0–D4 и routes[]: say, chat,&lt;br&gt;task, focus, think, digest, ignore;&lt;br&gt;пишет решение в журнал&lt;br&gt;→ Decision&lt;br&gt;сейчас: attention._decide, _act,&lt;br&gt;_finish" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_dec"><mxGeometry x="12" y="446.5" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="conv" value="&lt;b&gt;ConversationService&lt;/b&gt; [Сценарии]&lt;br&gt;обращение владельца: проверки → ветка&lt;br&gt;(болтовня / просьба / «что умеешь») →&lt;br&gt;ответ&lt;br&gt;→ Reply или Task&lt;br&gt;сейчас: app/conversation_service.py&lt;br&gt;(фасад Companion)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_conv"><mxGeometry x="12" y="44" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="ctx" value="&lt;b&gt;ContextBuilder&lt;/b&gt; [Сценарии]&lt;br&gt;собирает контекст: характер, память,&lt;br&gt;диалог, состояние; бюджет токенов на&lt;br&gt;роль&lt;br&gt;→ Context&lt;br&gt;сейчас: app/context_builder.py: прежняя&lt;br&gt;склейка 6 источников, бюджета токенов&lt;br&gt;пока нет" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_conv"><mxGeometry x="12" y="183.0" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="reply" value="&lt;b&gt;ReplyGenerator&lt;/b&gt; [Сценарии]&lt;br&gt;LanguageModel(fast) → LM Studio&lt;br&gt;(Gemma): ответ; страховки стиля&lt;br&gt;→ ReplyCandidate&lt;br&gt;сейчас: app/reply_generator.py:&lt;br&gt;_converse, _declutter + fast_brain" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_conv"><mxGeometry x="12" y="336.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="reflect" value="&lt;b&gt;ReflectionService&lt;/b&gt; [Сценарии]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;внутренний диалог в несколько шагов по&lt;br&gt;событию или импульсу; читает память;&lt;br&gt;лимиты шагов и токенов&lt;br&gt;→ Intent: сказать, сделать, напомнить,&lt;br&gt;записать, ничего&lt;br&gt;сейчас: нет: сейчас только&lt;br&gt;proactive_loop (опрос себя раз в 30 с)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;dashed=1;" vertex="1" parent="g_think"><mxGeometry x="12" y="44.0" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="thoughts" value="&lt;b&gt;Журнал мыслей&lt;/b&gt; [Адаптеры]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;внутренние рассуждения: не&lt;br&gt;озвучиваются; основа дневника и&lt;br&gt;эпизодов&lt;br&gt;→ Thought&lt;br&gt;сейчас: нет" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;dashed=1;" vertex="1" parent="g_think"><mxGeometry x="12" y="197.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;ToolRegistry&lt;/b&gt; [Сценарии]&lt;br&gt;инструменты ядра и модулей, видимость&lt;br&gt;по профилю, отбор по смыслу&lt;br&gt;→ Tool[]&lt;br&gt;сейчас: environments/registry.py,&lt;br&gt;tool_search.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_act"><mxGeometry x="12" y="44" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b&gt;Planner&lt;/b&gt; [Сценарии]&lt;br&gt;LanguageModel → LM Studio (Gemma): план&lt;br&gt;шагов или «не могу»&lt;br&gt;→ Plan&lt;br&gt;сейчас: router._plan" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_act"><mxGeometry x="12" y="168.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;RiskPolicy + Approver&lt;/b&gt; [Домен]&lt;br&gt;риск auto / ask / public / danger;&lt;br&gt;вопрос пользователю, ответ да/нет&lt;br&gt;→ Approval&lt;br&gt;сейчас: router._step + approvals.py:&lt;br&gt;301 строка" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_act"><mxGeometry x="12" y="278.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="exec" value="&lt;b&gt;Executor (ToolInvoker)&lt;/b&gt; [Сценарии]&lt;br&gt;вызов инструмента в ядре или модуле,&lt;br&gt;коды ошибок, итог-факт&lt;br&gt;→ ToolResult&lt;br&gt;сейчас: router._step и _run_step" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_act"><mxGeometry x="12" y="403.0" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="jobs" value="&lt;b&gt;JobTracker&lt;/b&gt; [Сценарии]&lt;br&gt;долгие задачи: прогресс, вопросы, итог;&lt;br&gt;Claude-помощник (Agent SDK)&lt;br&gt;→ JobState&lt;br&gt;сейчас: module_registry +&lt;br&gt;attention.on_job_update +&lt;br&gt;desktop.assistant_agent" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_act"><mxGeometry x="12" y="513.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="fmgr" value="&lt;b&gt;FocusManager (фасад)&lt;/b&gt; [Сценарии]&lt;br&gt;один слот, протокол переключения,&lt;br&gt;команды пользователя, журнал; прежние&lt;br&gt;публичные методы&lt;br&gt;→ FocusDecision&lt;br&gt;сейчас: focus.py: фасад над четырьмя&lt;br&gt;частями (ТЗ 29, ARC-6)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="44.0" width="268" height="125.0" as="geometry"/></mxCell><mxCell id="fpol" value="&lt;b&gt;FocusPolicy&lt;/b&gt; [Домен]&lt;br&gt;чистые правила: приоритет, запас,&lt;br&gt;критичное, старение, конфликты&lt;br&gt;→ FocusDecision&lt;br&gt;сейчас: domain/focus_policy.py: gate,&lt;br&gt;ambiguity, дребезг, эшелон" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#efe9fb;strokeColor=#7a5ac8;" vertex="1" parent="g_foc"><mxGeometry x="12" y="183.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="fque" value="&lt;b&gt;FocusQueue&lt;/b&gt; [Сценарии]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;состояния событий, склейка, старение,&lt;br&gt;сроки&lt;br&gt;→ QueuedEvent&lt;br&gt;сейчас: focus_queue.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;dashed=1;" vertex="1" parent="g_foc"><mxGeometry x="12" y="307.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="fstore" value="&lt;b&gt;CheckpointStore&lt;/b&gt; [Сценарии]&lt;i&gt; нужно выделить&lt;/i&gt;&lt;br&gt;checkpoint задач и файл focus.json&lt;br&gt;→ checkpoint&lt;br&gt;сейчас: focus_store.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;dashed=1;" vertex="1" parent="g_foc"><mxGeometry x="12" y="417.5" width="268" height="81.5" as="geometry"/></mxCell><mxCell id="fdisp" value="&lt;b&gt;FocusDispatch (контракт)&lt;/b&gt; [Сценарии]&lt;br&gt;Gemma только для неоднозначного; ответ&lt;br&gt;строго проверяется&lt;br&gt;→ Op&lt;br&gt;сейчас: focus_dispatch.py: класс&lt;br&gt;FocusDispatch и validate" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_foc"><mxGeometry x="12" y="513.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="queue" value="&lt;b&gt;SpeechQueue&lt;/b&gt; [Сценарии]&lt;br&gt;приоритеты, условия «не перебиваю»,&lt;br&gt;интервалы, прерывание, TTL; чистую&lt;br&gt;политику выбора выделить в домен позже&lt;br&gt;→ Utterance&lt;br&gt;сейчас: speech_queue.py: 296 строк,&lt;br&gt;асинхронный координатор (asyncio-&lt;br&gt;задачи), в домен целиком не переносится" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_out"><mxGeometry x="12" y="44" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="digest" value="&lt;b&gt;Digest&lt;/b&gt; [Сценарии]&lt;br&gt;сводка событий D1 и предложение&lt;br&gt;рассказать&lt;br&gt;→ SpeechCandidate&lt;br&gt;сейчас: attention._digest_*" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_out"><mxGeometry x="12" y="197.5" width="268" height="96.0" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;SpeechOutput и каналы (контракты)&lt;/b&gt; [Адаптеры]&lt;br&gt;голос (speak), чат, Telegram (deliver),&lt;br&gt;питомец&lt;br&gt;→ доставка&lt;br&gt;сейчас: speech_out.py,&lt;br&gt;conversation_io.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_out"><mxGeometry x="12" y="307.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="aff" value="&lt;b&gt;Presence и эмоции&lt;/b&gt; [Сценарии]&lt;br&gt;говорит ли, эмоция, присутствие; (план)&lt;br&gt;настроение&lt;br&gt;→ PresenceState&lt;br&gt;сейчас: PresenceTracker +&lt;br&gt;fast_brain.publish" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_out"><mxGeometry x="12" y="432.0" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="hubout" value="&lt;b&gt;ModuleHub (исходящие)&lt;/b&gt; [Адаптеры]&lt;br&gt;доставка команд модулям: tool.call,&lt;br&gt;speak, policy.activate, job.answer&lt;br&gt;→ ToolResult, события&lt;br&gt;сейчас: тот же module_hub.py, смешан с&lt;br&gt;приёмом" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_out"><mxGeometry x="12" y="556.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="mw" value="&lt;b&gt;MemoryWriter&lt;/b&gt; [Сценарии]&lt;br&gt;сразу: диалог и журнал; в паузе: факты&lt;br&gt;(Gemma + эмбеддинги); раз в 6 реплик:&lt;br&gt;осмысление; (план) эпизоды и сон&lt;br&gt;→ MemoryRecord&lt;br&gt;сейчас: app/memory_capture.py: _learn,&lt;br&gt;_consolidate, remember_text +&lt;br&gt;graph_memory.step" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_mem"><mxGeometry x="12" y="44.0" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="mr" value="&lt;b&gt;MemoryReader&lt;/b&gt; [Сценарии]&lt;br&gt;граф + воспоминания о себе + записи;&lt;br&gt;(план) гибридный поиск&lt;br&gt;→ MemoryHit[]&lt;br&gt;сейчас: graph.search, self_memories,&lt;br&gt;MemoryStore.relevant (два поиска)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e6f0fb;strokeColor=#2b6fba;" vertex="1" parent="g_mem"><mxGeometry x="308" y="44.0" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="elog" value="&lt;b&gt;EventLog&lt;/b&gt; [Адаптеры]&lt;br&gt;SQLite events.db: журнал событий,&lt;br&gt;трасса, решения&lt;br&gt;→ контракт журнала&lt;br&gt;сейчас: events_log.py: глобальные&lt;br&gt;функции, 16 импортов" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="604" y="44.0" width="268" height="139.5" as="geometry"/></mxCell><mxCell id="stores" value="&lt;b&gt;Диалог, записи, люди&lt;/b&gt; [Адаптеры]&lt;br&gt;JSON: диалог, MemoryStore (планы,&lt;br&gt;напоминания), отношения&lt;br&gt;→ репозитории&lt;br&gt;сейчас: user_memory.py,&lt;br&gt;memory_store.py, relationships.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="12" y="197.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="graph" value="&lt;b&gt;FactGraph (контракт)&lt;/b&gt; [Адаптеры]&lt;br&gt;Graphiti: факты с интервалами&lt;br&gt;валидности&lt;br&gt;→ контракт графа&lt;br&gt;сейчас: graph_memory.py: 701 строка" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="308" y="197.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="char" value="&lt;b&gt;CharacterRepo&lt;/b&gt; [Адаптеры]&lt;br&gt;resources/&lt;Имя&gt;: конституция, prompt,&lt;br&gt;канон, голос&lt;br&gt;→ Character&lt;br&gt;сейчас: character.py + resources/" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_mem"><mxGeometry x="604" y="197.5" width="268" height="110.5" as="geometry"/></mxCell><mxCell id="lms" value="&lt;b&gt;LM Studio :1234&lt;/b&gt; [Внешнее]&lt;br&gt;Gemma (речь, план, факты) и&lt;br&gt;EmbeddingGemma" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="12" y="44.0" width="226" height="125.0" as="geometry"/></mxCell><mxCell id="gli" value="&lt;b&gt;GLiNER decider :8768&lt;/b&gt; [Внешнее]&lt;br&gt;классификатор событий и&lt;br&gt;обращений" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="252" y="44.0" width="226" height="125.0" as="geometry"/></mxCell><mxCell id="falk" value="&lt;b&gt;FalkorDB :6380&lt;/b&gt; [Внешнее]&lt;br&gt;база графа фактов" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="492" y="44.0" width="226" height="125.0" as="geometry"/></mxCell><mxCell id="fish" value="&lt;b&gt;Fish Speech / edge-tts&lt;/b&gt; [Внешнее]&lt;br&gt;синтез речи" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="732" y="44.0" width="226" height="125.0" as="geometry"/></mxCell><mxCell id="wx" value="&lt;b&gt;WhisperX / Whisper&lt;/b&gt; [Внешнее]&lt;br&gt;распознавание речи" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="972" y="44.0" width="226" height="125.0" as="geometry"/></mxCell><mxCell id="cl" value="&lt;b&gt;Claude Agent SDK&lt;/b&gt; [Внешнее]&lt;br&gt;долгие и сложные задачи" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#eceff3;strokeColor=#6b7683;" vertex="1" parent="g_ext"><mxGeometry x="1212" y="44.0" width="226" height="125.0" as="geometry"/></mxCell><mxCell id="sup" value="&lt;b&gt;Supervisor&lt;/b&gt; [Адаптеры]&lt;br&gt;запуск и перезапуск процессов&lt;br&gt;модулей&lt;br&gt;сейчас: supervisor.py: 573&lt;br&gt;строки" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_ext"><mxGeometry x="1452" y="44.0" width="226" height="125.0" as="geometry"/></mxCell><mxCell id="root" value="&lt;b&gt;Composition root&lt;/b&gt; [Адаптеры]&lt;br&gt;только собирает объекты и&lt;br&gt;подставляет контракты; бизнес-&lt;br&gt;логики быть не должно&lt;br&gt;сейчас: core_service.py: 22&lt;br&gt;импорта, внутри обработчики&lt;br&gt;voice, colonists, run_lost" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#e3f5ea;strokeColor=#1f9d55;" vertex="1" parent="g_ext"><mxGeometry x="1692" y="44.0" width="226" height="125.0" as="geometry"/></mxCell><mxCell id="e1" value="Event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="voice" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" source="desk" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a5ac8;fontSize=9;" edge="1" parent="1" 