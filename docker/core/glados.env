# Параметры контейнера ядра для персонажа ГЛаДОС (без секретов). Секреты и GITS_MODULE_TOKEN лежат в .env в корне репозитория.
# Запуск: docker compose -f docker/core/compose.yml --env-file docker/core/glados.env up -d
CHARACTER_ID=glados
# папка персонажа на хосте (относительно docker/core/ или абсолютный путь)
CHARACTER_DIR=../../resources/GlaDOS
# порт ядра на хосте (только 127.0.0.1); хостовые модули: GITS_CORE_URL=ws://127.0.0.1:<порт>/module/ws
CORE_PORT=8766
# Монтаж (профиль montage, см. README): путь к auth.json pi на хосте подключается в compose.yml (секция закомментирована), здесь значения нет
# GITS_PI_AUTH_FILE=
