# Параметры контейнера ядра для персонажа ГЛаДОС (без секретов). Секреты и GITS_TOKEN лежат в .env в корне репозитория.
# Запуск: docker compose -f docker/core/compose.yml --env-file docker/core/glados.env up -d
CHARACTER_ID=glados
# папка персонажа на хосте (относительно docker/core/ или абсолютный путь)
CHARACTER_DIR=../../resources/GlaDOS
# порт ядра на хосте (только 127.0.0.1); хостовые участники: GITS_CORE_URL=ws://127.0.0.1:<порт>/ws
CORE_PORT=8766
# Монтаж (общий контейнер montage в корневом docker-compose.yml, см. README): здесь настроек нет; auth.json pi подключается в корневом compose (секция закомментирована)
# GITS_PI_AUTH_FILE=
# внимание v2 (docs/RUNTIME_SPEC.md): v2 включает; пусто: прежнее внимание. Откат: пусто и `docker compose ... up -d`
GITS_ATTENTION=v2
# Telegram: разговоры ведёт бот (Bot API) вместо её аккаунта. Откат: пусто и `docker compose ... up -d`
GITS_TG_ACCOUNT_MODE=bot
