{
  "name": "montage-template",
  "version": "0.1.0",
  "private": true,
  "description": "Базовый проект Remotion модуля монтажа (ТЗ 20 §9, ТЗ 21). Все пакеты Remotion одной точной версией.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "typecheck": "tsc --noEmit",
    "sync-assets": "node scripts/sync-assets.mjs",
    "check-scenes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-scenes.mjs",
    "gen:qa-zones": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-qa-zones.mjs",
    "gen:schema": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-schema.mjs",
    "validate-plan": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-plan.mjs",
    "demo:plans": "node demo/make-demo-plans.mjs",
    "demo:media": "node demo/make-demo-media.mjs",
    "demo:stills": "node demo/render-demo-stills.mjs"
  },
  "dependencies": {
    "@remotion/captions": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/media-utils": "4.0.534",
    "@remotion/zod-types": "4.0.534",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.534",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  }
}
