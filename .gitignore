resources/*/shared/

# готовые ролики монтажа (MONTAGE_OUT_DIR в контейнере: CHARACTER_HOME/montage/out)
resources/*/montage/out/
resources/*/montage/jobs/

# временный QR для входа в аккаунт Telegram (tg_login.py --qr)
resources/*/tg_login_qr.*

